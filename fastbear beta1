local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer

local WALK_ID = "rbxassetid://88377575394226"
local RUN_ID = "rbxassetid://94684107346506"
local SWING_ID = "rbxassetid://86829213006421"
local MUSIC_ID = "rbxassetid://80102232368924"

local WALK_SPEED = 32
local RUN_SPEED = 100
local MAX_STAMINA = 1893

local stamina = MAX_STAMINA
local running = false
local lms = false
local musicOn = false
local lastSwing = -100
local swinging = false

local character, humanoid, animator
local walkTrack, runTrack, swingTrack

local function loadTrack(id, priority, looped)
    local anim = Instance.new("Animation")
    anim.AnimationId = id
    local track = animator:LoadAnimation(anim)
    track.Priority = priority
    track.Looped = looped
    return track
end

local function setupCharacter(char)
    character = char
    humanoid = char:WaitForChild("Humanoid")
    animator = humanoid:WaitForChild("Animator")

    local ok, err = pcall(function()
        walkTrack = loadTrack(WALK_ID, Enum.AnimationPriority.Movement, true)
        runTrack = loadTrack(RUN_ID, Enum.AnimationPriority.Movement, true)
        swingTrack = loadTrack(SWING_ID, Enum.AnimationPriority.Action, false)
    end)

    if not ok then
        warn("Fastbear animation error:", err)
    end
end

if player.Character then
    setupCharacter(player.Character)
end

player.CharacterAdded:Connect(setupCharacter)


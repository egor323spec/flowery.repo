local function makeButton(name, y, callback)
    local b = Instance.new("TextButton")
    b.Position = UDim2.fromOffset(10, y)
    b.Size = UDim2.new(1, -20, 0, 30)
    b.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.TextScaled = true
    b.Text = name
    b.Parent = frame
    b.MouseButton1Click:Connect(callback)
    return b
end

local runButton
local lmsButton
local musicButton

local function setRun(value)
    running = value
    if runButton then
        runButton.Text = running and "RUN: ON" or "RUN: OFF"
    end
end

local function toggleLMS()
    lms = not lms
    lmsButton.Text = lms and "LMS: ON" or "LMS: OFF"
end

local function toggleMusic()
    local sound = SoundService:FindFirstChild("FastbearMusic")
    if not sound then
        sound = Instance.new("Sound")
        sound.Name = "FastbearMusic"
        sound.SoundId = MUSIC_ID
        sound.Volume = 1
        sound.Looped = true
        sound.Parent = SoundService
    end

    musicOn = not musicOn
    if musicOn then
        sound:Play()
        musicButton.Text = "MUSIC: STOP"
    else
        sound:Stop()
        musicButton.Text = "MUSIC: PLAY"
    end
end

local function doSwing()
    local cooldown = lms and 10 or 24
    if swinging or os.clock() - lastSwing < cooldown then
        return
    end

    if swingTrack then
        swinging = true
        lastSwing = os.clock()
        swingTrack:Play()

        task.delay(1.2, function()
            swinging = false
        end)
    end
end

runButton = makeButton("RUN: OFF", 88, function()
    setRun(not running)
end)

lmsButton = makeButton("LMS: OFF", 124, toggleLMS)

makeButton("SWING (E)", 160, doSwing)

musicButton = makeButton("MUSIC: PLAY", 196, toggleMusic)

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.LeftControl then
        setRun(true)
    elseif input.KeyCode == Enum.KeyCode.R then
        toggleLMS()
    elseif input.KeyCode == Enum.KeyCode.E then
        doSwing()
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftControl then
        setRun(false)
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if not humanoid or humanoid.Health <= 0 then return end

    local moving = humanoid.MoveDirection.Magnitude > 0.05
    local canRun = running and stamina > 0 and moving

    if canRun then
        stamina = math.max(0, stamina - (lms and 10 or 200) * dt)
    else
        stamina = math.min(MAX_STAMINA, stamina + (lms and 200 or 150) * dt)
    end

    humanoid.WalkSpeed = canRun and RUN_SPEED or WALK_SPEED

    if not swinging then
        if canRun then
            if walkTrack and walkTrack.IsPlaying then walkTrack:Stop() end
            if runTrack and not runTrack.IsPlaying then runTrack:Play() end
        elseif moving then
            if runTrack and runTrack.IsPlaying then runTrack:Stop() end
            if walkTrack and not walkTrack.IsPlaying then walkTrack:Play() end
        else
            if walkTrack and walkTrack.IsPlaying then walkTrack:Stop() end
            if runTrack and runTrack.IsPlaying then runTrack:Stop() end
        end
    end

    fill.Size = UDim2.fromScale(stamina / MAX_STAMINA, 1)
    status.Text = string.format(
        "%s | STAMINA: %d",
        lms and "LMS" or "NORMAL",
        stamina
    )
end)

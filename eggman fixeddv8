-- Перетаскивание меню
local dragging = false
local dragStart, startPos

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- Энергетический щит
local shieldActive = false

local function activateShield()
    if shieldActive then return end

    local _, humanoid, root = characterParts()
    if not humanoid or not root or humanoid.Health <= 0 then return end

    shieldActive = true

    local shield = Instance.new("Part")
    shield.Name = "EggmanEnergyShield"
    shield.Shape = Enum.PartType.Ball
    shield.Size = Vector3.new(10, 10, 10)
    shield.Material = Enum.Material.ForceField
    shield.Color = Color3.fromRGB(0, 200, 255)
    shield.Transparency = 0.35
    shield.CanCollide = false
    shield.Massless = true
    shield.CFrame = root.CFrame
    shield.Parent = workspace

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = shield
    weld.Parent = shield

    playSound(IDS.Shield)

    task.delay(SHIELD_DURATION, function()
        if shield.Parent then shield:Destroy() end
        shieldActive = false
    end)
end

-- Дэш + белые звёздочки + дым из ног
local dashActive = false

local function activateDash()
    if dashActive then return end

    local character, humanoid, root = characterParts()
    if not humanoid or not root or humanoid.Health <= 0 then return end

    dashActive = true

    local attachments = {}

    local function addEffect(part, texture, rate, lifetime, size)
        local a = Instance.new("Attachment")
        a.Parent = part
        table.insert(attachments, a)

        local emitter = Instance.new("ParticleEmitter")
        emitter.Texture = texture
        emitter.Color = ColorSequence.new(Color3.new(1, 1, 1))
        emitter.LightEmission = 0.8
        emitter.Rate = rate
        emitter.Lifetime = NumberRange.new(lifetime * 0.7, lifetime)
        emitter.Speed = NumberRange.new(2, 7)
        emitter.SpreadAngle = Vector2.new(180, 180)
        emitter.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, size),
            NumberSequenceKeypoint.new(1, 0)
        })
        emitter.Parent = a
    end

    addEffect(
        root,
        "rbxasset://textures/particles/sparkles_main.dds",
        100, 0.5, 0.3
    )

    for _, name in ipairs({"LeftFoot", "RightFoot", "Left Leg", "Right Leg"}) do
        local leg = character:FindFirstChild(name)
        if leg and leg:IsA("BasePart") then
            addEffect(
                leg,
                "rbxasset://textures/particles/smoke_main.dds",
                60, 0.7, 1.2
            )
        end
    end

    playSound(IDS.Dash)

    local started = os.clock()

    while os.clock() - started < DASH_DURATION do
        if not root.Parent or humanoid.Health <= 0 then break end

        local camera = workspace.CurrentCamera
        if camera then
            local move = humanoid.MoveDirection
            local direction

            if move.Magnitude > 0.05 then
                -- Проекция WASD на горизонтальное направление камеры
                local forward = Vector3.new(
                    camera.CFrame.LookVector.X, 0,
                    camera.CFrame.LookVector.Z
                )
                local right = Vector3.new(
                    camera.CFrame.RightVector.X, 0,
                    camera.CFrame.RightVector.Z
                )

                if forward.Magnitude > 0 then forward = forward.Unit end
                if right.Magnitude > 0 then right = right.Unit end

                local facing = Vector3.new(
                    root.CFrame.LookVector.X, 0,
                    root.CFrame.LookVector.Z
                )
                local side = Vector3.new(
                    root.CFrame.RightVector.X, 0,
                    root.CFrame.RightVector.Z
                )

                direction = Vector3.zero
                if facing.Magnitude > 0 then
                    direction += forward * move:Dot(facing.Unit)
                end
                if side.Magnitude > 0 then
                    direction += right * move:Dot(side.Unit)
                end
            else
                direction = Vector3.new(
                    camera.CFrame.LookVector.X, 0,
                    camera.CFrame.LookVector.Z
                )
            end

            if direction.Magnitude > 0.01 then
                direction = direction.Unit
                root.AssemblyLinearVelocity = Vector3.new(
                    direction.X * DASH_SPEED,
                    root.AssemblyLinearVelocity.Y,
                    direction.Z * DASH_SPEED
                )
            end
        end

        RunService.Heartbeat:Wait()
    end

    for _, a in ipairs(attachments) do
        if a.Parent then a:Destroy() end
    end

    dashActive = false
end

-- Музыка
local music
local musicButton

local function toggleMusic()
    if music then
        music:Stop()
        music:Destroy()
        music = nil
        musicButton.Text = "CRACKED EMPIRE: OFF"
    else
        music = playSound(IDS.CrackedEmpire, true)
        musicButton.Text = "CRACKED EMPIRE: ON"
    end
end


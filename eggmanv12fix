local function toggleMusic(name, soundId)
    if music and music.Parent then
        music:Stop()
        music:Destroy()
        music = nil

        if musicName == name then
            musicName = nil
            return
        end
    end

    musicName = name
    music = Instance.new("Sound")
    music.Name = "EggmanMusic"
    music.SoundId = soundId
    music.Volume = 0.8
    music.Looped = true
    music.Parent = root
    music:Play()
end


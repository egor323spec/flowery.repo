local function playSound(id, parent, volume)
    local sound = Instance.new("Sound")
    sound.SoundId = id
    sound.Volume = volume or 1
    sound.RollOffMaxDistance = 100
    sound.Parent = parent or root
    sound:Play()
    Debris:AddItem(sound, 12)
    return sound
end

local function loadAnimation(name, id)
    local animation = Instance.new("Animation")
    animation.AnimationId = id

    local success, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    animation:Destroy()

    if success and track then
        tracks[name] = track
        return track
    end
end

local function loadAnimations()
    tracks = {}
    for name, id in pairs(ANIMATION) do
        loadAnimation(name, id)
    end
end

loadAnimations()

local function stopTrack(name)
    if tracks[name] then
        pcall(function()
            tracks[name]:Stop(0.15)
        end)
    end
end

local function playTrack(name, looped)
    local track = tracks[name]
    if not track then return end

    track.Looped = looped or false
    pcall(function()
        track:Play(0.15)
    end)
end


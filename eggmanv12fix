-- SHIELD
local function destroyShield()
    if shieldWeld then
        shieldWeld:Destroy()
        shieldWeld = nil
    end

    if shield then
        shield:Destroy()
        shield = nil
    end
end

local function makeFlash()
    if not character then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "EggmanShieldFlash"
    highlight.Adornee = character
    highlight.FillColor = Color3.new(1, 1, 1)
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.05
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    task.wait(0.12)
    if highlight.Parent then
        highlight:Destroy()
    end
end

local function activateShield()
    if shieldActive or not character or not root then return end

    shieldActive = true
    shieldGeneration += 1
    local myGeneration = shieldGeneration

    playSound(SOUND.Shield, root)

    local ball = Instance.new("Part")
    ball.Name = "EggmanShield"
    ball.Shape = Enum.PartType.Ball
    ball.Size = Vector3.new(0.5, 0.5, 0.5)
    ball.Material = Enum.Material.ForceField
    ball.Color = Color3.fromRGB(130, 205, 255)
    ball.Transparency = 0.45
    ball.CanCollide = false
    ball.CanTouch = false
    ball.CanQuery = false
    ball.Massless = true
    ball.CFrame = root.CFrame
    ball.Parent = character

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = ball
    weld.Parent = ball

    shield = ball
    shieldWeld = weld

    TweenService:Create(
        ball,
        TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Size = Vector3.new(SHIELD_DIAMETER, SHIELD_DIAMETER, SHIELD_DIAMETER)}
    ):Play()

    task.delay(SHIELD_DURATION, function()
        if myGeneration ~= shieldGeneration or not shieldActive then
            return
        end

        shieldActive = false

        if shield and shield.Parent then
            playSound(SOUND.Retract, root)

            local activeShield = shield
            local tween = TweenService:Create(
                activeShield,
                TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                {
                    Size = Vector3.new(0.2, 0.2, 0.2),
                    Transparency = 1
                }
            )
            tween:Play()
            tween.Completed:Wait()
        end

        if myGeneration == shieldGeneration then
            destroyShield()
            makeFlash()
            task.wait(0.2)
            makeFlash()
        end
    end)
end


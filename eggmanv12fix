-- EXPANDING WHITE TORUS RINGS
local function createRing(index)
    local ring = Instance.new("Part")
    ring.Name = "EggmanWhiteRing"
    ring.Anchored = true
    ring.CanCollide = false
    ring.CanTouch = false
    ring.CanQuery = false
    ring.Material = Enum.Material.Neon
    ring.Color = Color3.new(1, 1, 1)
    ring.Transparency = 0.05
    ring.Size = Vector3.new(1, 1, 1)
    ring.CFrame = root.CFrame
    ring.Parent = workspace

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Torus
    mesh.Scale = Vector3.new(1, 0.25, 1)
    mesh.Parent = ring

    local startPosition = root.Position
    local startSize = 2
    local endSize = 20

    ring.Size = Vector3.new(startSize, startSize, startSize)
    ring.CFrame = CFrame.new(startPosition)

    local duration = 0.65
    local startTime = os.clock()

    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not ring.Parent then
            connection:Disconnect()
            return
        end

        local alpha = math.clamp((os.clock() - startTime) / duration, 0, 1)
        local size = startSize + (endSize - startSize) * alpha

        ring.Size = Vector3.new(size, size, size)
        ring.CFrame = CFrame.new(startPosition)

        if alpha >= 1 then
            connection:Disconnect()
            ring:Destroy()
        end
    end)

    Debris:AddItem(ring, 1.2)
end

local function shieldStrike()
    if not shieldActive or not root then return end

    playSound(SOUND.Strike, root)

    -- Blue spherical shockwave first
    createShockwave()

    -- Shield disappears shortly after the strike
    shieldGeneration += 1
    local myGeneration = shieldGeneration

    task.delay(0.2, function()
        if myGeneration ~= shieldGeneration then return end

        shieldActive = false
        destroyShield()

        for i = 1, 3 do
            task.delay((i - 1) * 0.2, function()
                if root and root.Parent then
                    createRing(i)
                end
            end)
        end
    end)
end

-- JETPACK PARTICLES
local function getLegParts()
    local result = {}

    local candidates = {
        "LeftFoot", "RightFoot",
        "LeftLowerLeg", "RightLowerLeg",
        "Left Leg", "Right Leg"
    }

    for _, name in ipairs(candidates) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            table.insert(result, part)
        end
    end

    if #result == 0 and root then
        table.insert(result, root)
    end

    return result
end

local function createJetpackEmitter(part, texture, isSmoke)
    local attachment = Instance.new("Attachment")
    attachment.Name = "EggmanJetpackAttachment"
    attachment.Position = Vector3.new(0, -part.Size.Y * 0.4, 0)
    attachment.Parent = part

    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = isSmoke and "JetpackSmoke" or "JetpackStars"
    emitter.Texture = texture
    emitter.Enabled = true
    emitter.Rate = isSmoke and 45 or 30
    emitter.Lifetime = isSmoke
        and NumberRange.new(0.3, 0.65)
        or NumberRange.new(0.25, 0.5)
    emitter.Speed = isSmoke
        and NumberRange.new(5, 10)
        or NumberRange.new(7, 14)
    emitter.SpreadAngle = Vector2.new(30, 30)
    emitter.EmissionDirection = Enum.NormalId.Bottom
    emitter.Drag = 3
    emitter.LightEmission = 0.8
    emitter.RotSpeed = NumberRange.new(-180, 180)
    emitter.Rotation = NumberRange.new(0, 360)
    emitter.Size = isSmoke
        and NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.5),
            NumberSequenceKeypoint.new(1, 1.5)
        })
        or NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.35),
            NumberSequenceKeypoint.new(1, 0)
        })
    emitter.Transparency = isSmoke
        and NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.25),
            NumberSequenceKeypoint.new(1, 1)
        })
        or NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(1, 1)
        })
    emitter.Parent = attachment

    return attachment
end

-- DASH: locks horizontal direction and preserves vertical velocity.
-- This avoids the dash steering downward when the character pitches.
local function jetpackDash()
    if dashActive or not character or not humanoid or not root then
        return
    end

    dashActive = true

    local look = root.CFrame.LookVector
    local direction = Vector3.new(look.X, 0, look.Z)

    if direction.Magnitude < 0.01 then
        direction = Vector3.new(0, 0, -1)
    else
        direction = direction.Unit
    end

    playSound(SOUND.Jetpack, root)
    playTrack("Jetpack", true)

    local attachments = {}
    for _, leg in ipairs(getLegParts()) do
        table.insert(attachments, createJetpackEmitter(
            leg,
            "rbxasset://textures/particles/smoke_main.dds",
            true
        ))
        table.insert(attachments, createJetpackEmitter(
            leg,
            "rbxasset://textures/particles/sparkles_main.dds",
            false
        ))
    end

    local dashAttachment = Instance.new("Attachment")
    dashAttachment.Name = "EggmanDashAttachment"
    dashAttachment.Parent = root

    local velocity = Instance.new("LinearVelocity")
    velocity.Name = "EggmanDashVelocity"
    velocity.Attachment0 = dashAttachment
    velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    velocity.VectorVelocity = direction * DASH_SPEED
        + Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
    velocity.MaxForce = 1000000
    velocity.Parent = root

    -- Hold the initial vertical velocity instead of adding a downward push.
    local initialY = root.AssemblyLinearVelocity.Y
    local startTime = os.clock()

    local heartbeatConnection
    heartbeatConnection = RunService.Heartbeat:Connect(function()
        if not root or not root.Parent or not dashActive then
            return
        end

        velocity.VectorVelocity =
            direction * DASH_SPEED + Vector3.new(0, initialY, 0)

        if os.clock() - startTime >= DASH_DURATION then
            heartbeatConnection:Disconnect()
        end
    end)

    task.wait(DASH_DURATION)

    if heartbeatConnection then
        heartbeatConnection:Disconnect()
    end

    if velocity then velocity:Destroy() end
    if dashAttachment then dashAttachment:Destroy() end

    for _, attachment in ipairs(attachments) do
        if attachment and attachment.Parent then
            for _, child in ipairs(attachment:GetChildren()) do
                if child:IsA("ParticleEmitter") then
                    child.Enabled = false
                end
            end
            Debris:AddItem(attachment, 1)
        end
    end

    stopTrack("Jetpack")
    dashActive = false
end


local function doubleJumpSmoke()
    if not character then return end

    for _, name in ipairs({"LeftFoot", "RightFoot", "Left Leg", "Right Leg"}) do
        local leg = character:FindFirstChild(name)
        if leg and leg:IsA("BasePart") then
            local att = Instance.new("Attachment")
            att.Position = Vector3.new(0, -leg.Size.Y * 0.35, 0)
            att.Parent = leg

            local smoke = Instance.new("ParticleEmitter")
            smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
            smoke.Rate = 0
            smoke.Lifetime = NumberRange.new(0.55, 0.9)
            smoke.Speed = NumberRange.new(5, 10)
            smoke.SpreadAngle = Vector2.new(35, 35)
            smoke.EmissionDirection = Enum.NormalId.Bottom
            smoke.Drag = 4
            smoke.Size = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 3),
                NumberSequenceKeypoint.new(0.4, 6),
                NumberSequenceKeypoint.new(1, 8)
            })
            smoke.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.2),
                NumberSequenceKeypoint.new(1, 1)
            })
            smoke.Parent = att
            smoke:Emit(24)
            Debris:AddItem(att, 1.2)
        end
    end
end


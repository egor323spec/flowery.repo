local function sound(id, parent, volume)
    if not parent then return end
    local s = Instance.new("Sound")
    s.SoundId = id
    s.Volume = volume or 1
    s.Parent = parent
    s:Play()
    Debris:AddItem(s, 20)
    return s
end

local function stopTrack(name)
    if tracks[name] then
        pcall(function() tracks[name]:Stop(0.1) end)
    end
end

local function playTrack(name, looped)
    local t = tracks[name]
    if not t then return end
    t.Looped = looped or false
    pcall(function() t:Play(0.1) end)
end

local function loadAnimations()
    tracks = {}
    for name, id in pairs(ANIMS) do
        local animation = Instance.new("Animation")
        animation.AnimationId = id

        local ok, track = pcall(function()
            return animator:LoadAnimation(animation)
        end)

        animation:Destroy()

        if ok and track then
            tracks[name] = track
            if name == "Idle" or name == "Walk" or name == "Run" then
                track.Priority = Enum.AnimationPriority.Movement
            else
                track.Priority = Enum.AnimationPriority.Action
            end
        end
    end
end

local function setRunning(value)
    running = value
    if humanoid then
        humanoid.WalkSpeed = running and RUN_SPEED or WALK_SPEED
    end
    if runButton then
        runButton.Text = running and "RUN: ON" or "RUN: OFF"
    end
end


local function getDashDirection()
    local camera = workspace.CurrentCamera
    if not camera then return Vector3.new(0, 0, -1) end

    local look = camera.CFrame.LookVector
    local right = camera.CFrame.RightVector
    local forward = Vector3.new(look.X, 0, look.Z)
    local side = Vector3.new(right.X, 0, right.Z)

    if forward.Magnitude > 0 then forward = forward.Unit end
    if side.Magnitude > 0 then side = side.Unit end

    local dir = Vector3.zero
    if heldKeys.W then dir += forward end
    if heldKeys.S then dir -= forward end
    if heldKeys.A then dir -= side end
    if heldKeys.D then dir += side end

    if dir.Magnitude < 0.01 then dir = forward end
    if dir.Magnitude < 0.01 then dir = Vector3.new(0, 0, -1) end
    return dir.Unit
end

local function dash()
    if dashActive or not root or not humanoid then return end
    dashActive = true

    sound(IDS.Jetpack, root)
    stopTrack("Idle")
    stopTrack("Walk")
    stopTrack("Run")
    playTrack("Dash", true)

    local particles = dashParticles()
    local att = Instance.new("Attachment")
    att.Parent = root

    local lv = Instance.new("LinearVelocity")
    lv.Attachment0 = att
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.ForceLimitsEnabled = true
    lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
    lv.MaxAxesForce = Vector3.new(1000000, 0, 1000000)
    lv.VectorVelocity = Vector3.zero
    lv.Parent = root

    local start = os.clock()
    local hitWall = false
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}

    dashConnection = RunService.Heartbeat:Connect(function()
        if not dashActive or not root or not root.Parent then return end
        local dir = getDashDirection()
        local hit = workspace:Raycast(root.Position, dir * 2.5, params)

        if hit and hit.Instance.CanCollide then
            hitWall = true
            return
        end

        lv.VectorVelocity = Vector3.new(dir.X * DASH_SPEED, 0, dir.Z * DASH_SPEED)
    end)

    while os.clock() - start < DASH_TIME and not hitWall do
        if not root or not root.Parent then break end
        task.wait(0.03)
    end

    if dashConnection then
        dashConnection:Disconnect()
        dashConnection = nil
    end

    if lv.Parent then lv:Destroy() end
    if att.Parent then att:Destroy() end

    if particles and particles.Parent then
        for _, obj in ipairs(particles:GetChildren()) do
            if obj:IsA("ParticleEmitter") then obj.Enabled = false end
        end
        Debris:AddItem(particles, 2)
    end

    stopTrack("Dash")
    dashActive = false
end

-- MUSIC
local function toggleMusic(name, id)
    if music then
        music:Stop()
        music:Destroy()
        music = nil
        if musicName == name then
            musicName = nil
            return
        end
    end

    if not root then return end
    musicName = name
    music = Instance.new("Sound")
    music.SoundId = id
    music.Volume = 0.8
    music.Looped = true
    music.Parent = root
    music:Play()
end


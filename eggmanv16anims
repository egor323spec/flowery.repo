-- SHIELD
local function removeShield()
    if shieldWeld then shieldWeld:Destroy(); shieldWeld = nil end
    if shield then shield:Destroy(); shield = nil end
end

local function whiteFlash()
    if not character then return end
    local h = Instance.new("Highlight")
    h.Adornee = character
    h.FillColor = Color3.new(1, 1, 1)
    h.OutlineColor = Color3.new(1, 1, 1)
    h.Parent = character
    Debris:AddItem(h, 0.15)
end

local function activateShield()
    if shieldActive or not root then return end
    shieldActive = true
    shieldToken += 1
    local token = shieldToken

    sound(IDS.Shield, root)

    shield = Instance.new("Part")
    shield.Name = "EggmanShield"
    shield.Shape = Enum.PartType.Ball
    shield.Size = Vector3.new(0.2, 0.2, 0.2)
    shield.Material = Enum.Material.ForceField
    shield.Color = Color3.fromRGB(100, 190, 255)
    shield.Transparency = 0.35
    shield.CanCollide = false
    shield.CanTouch = false
    shield.CanQuery = false
    shield.Massless = true
    shield.CFrame = root.CFrame
    shield.Parent = character

    shieldWeld = Instance.new("WeldConstraint")
    shieldWeld.Part0 = root
    shieldWeld.Part1 = shield
    shieldWeld.Parent = shield

    TweenService:Create(
        shield,
        TweenInfo.new(0.35, Enum.EasingStyle.Back),
        {Size = Vector3.new(11, 11, 11)}
    ):Play()

    task.delay(SHIELD_TIME, function()
        if token ~= shieldToken then return end
        shieldActive = false

        if shield and shield.Parent then
            sound(IDS.Retract, root)
            local oldShield = shield
            TweenService:Create(
                oldShield,
                TweenInfo.new(0.25),
                {Size = Vector3.new(0.1, 0.1, 0.1), Transparency = 1}
            ):Play()
            task.wait(0.3)
        end

        if token == shieldToken then
            removeShield()
            whiteFlash()
            task.wait(0.2)
            whiteFlash()
        end
    end)
end

local function shockwave()
    if not root then return end
    local p = Instance.new("Part")
    p.Shape = Enum.PartType.Ball
    p.Anchored = true
    p.CanCollide = false
    p.CanTouch = false
    p.CanQuery = false
    p.Material = Enum.Material.Neon
    p.Color = Color3.fromRGB(35, 140, 255)
    p.Transparency = 0.25
    p.Size = Vector3.one
    p.CFrame = root.CFrame
    p.Parent = workspace

    TweenService:Create(p, TweenInfo.new(0.45), {
        Size = Vector3.new(30, 30, 30),
        Transparency = 1
    }):Play()
    Debris:AddItem(p, 0.6)
end

local function whiteRing(position)
    local folder = Instance.new("Folder")
    folder.Parent = workspace
    local parts = {}
    local count = 40

    for i = 1, count do
        local p = Instance.new("Part")
        p.Anchored = true
        p.CanCollide = false
        p.CanTouch = false
        p.CanQuery = false
        p.Material = Enum.Material.Neon
        p.Color = Color3.new(1, 1, 1)
        p.Size = Vector3.new(0.12, 0.12, 0.5)
        p.Parent = folder
        parts[i] = p
    end

    local start = os.clock()
    local connection
    connection = RunService.Heartbeat:Connect(function()
        if not folder.Parent then
            connection:Disconnect()
            return
        end

        local a = math.clamp((os.clock() - start) / 0.7, 0, 1)
        local r = 1 + a * 9
        local center = position + Vector3.new(0, 0.5, 0)

        for i, p in ipairs(parts) do
            local t1 = (i - 1) / count * math.pi * 2
            local t2 = i / count * math.pi * 2
            local v1 = center + Vector3.new(math.cos(t1) * r, math.sin(t1) * r, 0)
            local v2 = center + Vector3.new(math.cos(t2) * r, math.sin(t2) * r, 0)
            local mid = (v1 + v2) / 2
            p.Size = Vector3.new(0.12, 0.12, (v2 - v1).Magnitude + 0.1)
            p.CFrame = CFrame.lookAt(mid, v2)
            p.Transparency = a
        end

        if a >= 1 then
            connection:Disconnect()
            folder:Destroy()
        end
    end)
    Debris:AddItem(folder, 1.2)
end

local function shieldStrike()
    if not shieldActive or not root then return end
    sound(IDS.Strike, root)
    shockwave()

    shieldToken += 1
    local token = shieldToken
    local pos = root.Position

    task.delay(0.2, function()
        if token ~= shieldToken then return end
        shieldActive = false
        removeShield()
        for i = 1, 3 do
            task.delay((i - 1) * 0.2, function()
                whiteRing(pos)
            end)
        end
    end)
end


-- KEYBOARD
UIS.InputBegan:Connect(function(input, processed)
    if input.KeyCode == Enum.KeyCode.W then heldKeys.W = true end
    if input.KeyCode == Enum.KeyCode.A then heldKeys.A = true end
    if input.KeyCode == Enum.KeyCode.S then heldKeys.S = true end
    if input.KeyCode == Enum.KeyCode.D then heldKeys.D = true end

    if not processed and (
        input.KeyCode == Enum.KeyCode.LeftShift
        or input.KeyCode == Enum.KeyCode.RightShift
    ) then
        setRunning(true)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then heldKeys.W = false end
    if input.KeyCode == Enum.KeyCode.A then heldKeys.A = false end
    if input.KeyCode == Enum.KeyCode.S then heldKeys.S = false end
    if input.KeyCode == Enum.KeyCode.D then heldKeys.D = false end

    if input.KeyCode == Enum.KeyCode.LeftShift
        or input.KeyCode == Enum.KeyCode.RightShift then
        setRunning(false)
    end
end)

-- DOUBLE JUMP
UIS.JumpRequest:Connect(function()
    if not humanoid or not root or dashActive or humanoid.Health <= 0 then
        return
    end

    if humanoid.FloorMaterial ~= Enum.Material.Air then
        jumpCount = 1
        canDoubleJump = true
        return
    end

    if jumpCount == 0 then jumpCount = 1 end

    if jumpCount == 1 and canDoubleJump then
        jumpCount = 2
        canDoubleJump = false

        sound(IDS.DoubleJump, root)
        doubleJumpSmoke()
        stopTrack("Fall")
        playTrack("Jump", false)

        local y
        if humanoid.UseJumpPower then
            y = humanoid.JumpPower
        else
            y = math.sqrt(2 * workspace.Gravity * humanoid.JumpHeight)
        end

        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(v.X, y, v.Z)
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- CHARACTER + ANIMATIONS
local function setupCharacter(char)
    character = char
    humanoid = char:WaitForChild("Humanoid")
    root = char:WaitForChild("HumanoidRootPart")

    animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    loadAnimations()
    jumpCount = 0
    canDoubleJump = true
    dashActive = false
    humanoid.WalkSpeed = running and RUN_SPEED or WALK_SPEED
    playTrack("Idle", true)

    humanoid.StateChanged:Connect(function(_, state)
        if state == Enum.HumanoidStateType.Landed then
            jumpCount = 0
            canDoubleJump = true
            stopTrack("Fall")
            stopTrack("Jump")
        elseif state == Enum.HumanoidStateType.Freefall and not dashActive then
            stopTrack("Jump")
            playTrack("Fall", true)
        end
    end)
end

RunService.Heartbeat:Connect(function()
    if not humanoid or not humanoid.Parent or dashActive then return end

    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.Jumping then
        return
    end

    if humanoid.MoveDirection.Magnitude > 0.05 then
        if running then
            if tracks.Run and not tracks.Run.IsPlaying then
                stopTrack("Walk")
                stopTrack("Idle")
                playTrack("Run", true)
            end
        else
            if tracks.Walk and not tracks.Walk.IsPlaying then
                stopTrack("Run")
                stopTrack("Idle")
                playTrack("Walk", true)
            end
        end
    else
        stopTrack("Walk")
        stopTrack("Run")
        if tracks.Idle and not tracks.Idle.IsPlaying then
            playTrack("Idle", true)
        end
    end
end)

player.CharacterAdded:Connect(function(char)
    shieldToken += 1
    shieldActive = false
    removeShield()

    if dashConnection then
        dashConnection:Disconnect()
        dashConnection = nil
    end

    dashActive = false

    if music then
        music:Stop()
        music:Destroy()
        music = nil
        musicName = nil
    end

    setupCharacter(char)
end)

setupCharacter(player.Character or player.CharacterAdded:Wait())

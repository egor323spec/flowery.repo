end

label("FLOWERY V5  |  CONTROL", 8, 30)
local status = label("Omega: OFF | Run: OFF", 42)
local chargeText = label("Charge: 0.000 / 3.000", 72)
local dashText = label("Dash: 0.000", 102)
local abilityText = label("Jarona: 0.4 sec | Speed: 45", 132)

local barBack = Instance.new("Frame")
barBack.Size = UDim2.new(1, -16, 0, 12)
barBack.Position = UDim2.fromOffset(8, 164)
barBack.BackgroundColor3 = Color3.fromRGB(65, 45, 80)
barBack.Parent = panel

local bar = Instance.new("Frame")
bar.Size = UDim2.fromScale(0, 1)
bar.BackgroundColor3 = Color3.fromRGB(255, 50, 220)
bar.BorderSizePixel = 0
bar.Parent = barBack


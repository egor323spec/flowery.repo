local function makeButton(text, y, callback)
    local button = Instance.new("TextButton")
    button.Name = text:gsub("[^%w]", "") .. "Button"
    button.Size = UDim2.new(1, -16, 0, 42)
    button.Position = UDim2.fromOffset(8, y)
    button.BackgroundColor3 = Color3.fromRGB(35, 100, 180)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.Text = text
    button.Parent = panel
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)
    button.Activated:Connect(callback)
    return button
end

-- White solid-looking ring made from overlapping SmoothPlastic pieces.
-- The pieces overlap so the rim has no visible gaps.
local function createWhiteRing(radius, yOffset)
    if not root then return {} end

    local pieces = {}
    local count = 64
    local center = root.Position

    for i = 1, count do
        local angle = (i / count) * math.pi * 2
        local part = Instance.new("Part")
        part.Name = "EggmanWhiteRing"
        part.Shape = Enum.PartType.Ball
        part.Material = Enum.Material.SmoothPlastic
        part.Color = Color3.new(1, 1, 1)
        part.Size = Vector3.new(0.34, 0.34, 0.34)
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Position = center + Vector3.new(
            math.cos(angle) * radius,
            yOffset,
            math.sin(angle) * radius
        )
        part.Parent = workspace
        table.insert(pieces, part)
    end

    return pieces
end

-- Three white O-shaped rings travel from the feet toward the head.
local function whiteBodyRings()
    for ringIndex = 1, 3 do
        task.delay((ringIndex - 1) * 0.2, function()
            if not root or not root.Parent then return end

            local ring = createWhiteRing(1.15, -2.7)
            local start = os.clock()
            local duration = 0.48

            while os.clock() - start < duration do
                if not root or not root.Parent then break end

                local alpha = math.clamp(
                    (os.clock() - start) / duration, 0, 1
                )

                local center = root.Position
                local yOffset = -2.7 + alpha * 5.2

                for i, part in ipairs(ring) do
                    if part.Parent then
                        local angle = (i / #ring) * math.pi * 2
                        part.Position = center + Vector3.new(
                            math.cos(angle) * 1.15,
                            yOffset,
                            math.sin(angle) * 1.15
                        )
                    end
                end
                RunService.Heartbeat:Wait()
            end

            for _, part in ipairs(ring) do
                if part.Parent then part:Destroy() end
            end
        end)
    end
end

-- Two brief white flashes of the character, like Flowery Omega.
local function eggmanEndFlash()
    task.wait(0.2)
    if not character then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "EggmanWhiteFlash"
    highlight.Adornee = character
    highlight.FillColor = Color3.new(1, 1, 1)
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character

    for i = 1, 2 do
        highlight.Enabled = true
        task.wait(0.1)
        highlight.Enabled = false
        if i == 1 then task.wait(0.2) end
    end

    highlight:Destroy()
end

-- Blue shockwave
local function blueExplosion()
    if not root then return end

    local wave = Instance.new("Part")
    wave.Name = "EggmanBlueExplosion"
    wave.Shape = Enum.PartType.Ball
    wave.Material = Enum.Material.SmoothPlastic
    wave.Color = Color3.fromRGB(50, 155, 255)
    wave.Transparency = 0.2
    wave.Size = Vector3.new(1, 1, 1)
    wave.CFrame = root.CFrame
    wave.Anchored = true
    wave.CanCollide = false
    wave.CanTouch = false
    wave.CanQuery = false
    wave.Parent = workspace

    TweenService:Create(
        wave,
        TweenInfo.new(0.35),
        {
            Size = Vector3.new(18, 18, 18),
            Transparency = 1
        }
    ):Play()

    Debris:AddItem(wave, 0.4)
end

local function retractShield()
    if not shieldPart or not shieldPart.Parent then
        shieldPart = nil
        shieldActive = false
        return
    end

    local part = shieldPart
    shieldPart = nil
    shieldActive = false

    playSound(IDS.Retract, root)

    local tween = TweenService:Create(
        part,
        TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        {
            Size = Vector3.new(0.1, 0.1, 0.1),
            Transparency = 1
        }
    )
    tween:Play()
    tween.Completed:Wait()

    if part.Parent then part:Destroy() end

    -- After the shield is gone, launch the rings and then flash Eggman.
    whiteBodyRings()
    task.spawn(eggmanEndFlash)
end

local function endShield(token)
    task.wait(SHIELD_TIME)
    if token ~= shieldToken or not shieldActive then return end

    -- The blue blast happens while the shield remains for 0.2 seconds.
    blueExplosion()
    task.wait(0.2)

    if token ~= shieldToken or not shieldActive then return end
    retractShield()
end

local function activateShield()
    if not root or shieldActive then return end

    shieldActive = true
    shieldToken += 1
    local token = shieldToken

    playSound(IDS.Shield, root)

    local ball = Instance.new("Part")
    ball.Name = "EggmanShield"
    ball.Shape = Enum.PartType.Ball
    ball.Material = Enum.Material.SmoothPlastic
    ball.Color = Color3.fromRGB(55, 160, 255)
    ball.Transparency = 0.4
    ball.Size = Vector3.new(0.2, 0.2, 0.2)
    ball.CanCollide = false
    ball.CanTouch = false
    ball.CanQuery = false
    ball.Massless = true
    ball.CFrame = root.CFrame
    ball.Parent = workspace

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = ball
    weld.Parent = ball

    shieldPart = ball

    TweenService:Create(
        ball,
        TweenInfo.new(0.35),
        {Size = Vector3.new(11, 11, 11)}
    ):Play()

    task.spawn(endShield, token)
end

local function shieldStrike()
    if not shieldActive then
        activateShield()
        return
    end

    -- Strike triggers the same ending sequence.
    shieldToken += 1
    local token = shieldToken

    blueExplosion()
    task.wait(0.2)

    if token ~= shieldToken or not shieldActive then return end
    retractShield()
end

local function dash()
    if dashActive or not humanoid or not root then return end

    dashActive = true
    stopMovementTracks()
    playTrack("Dash")
    playSound(IDS.Jetpack, root)

    local startTime = os.clock()
    while os.clock() - startTime < DASH_TIME do
        if not humanoid or humanoid.Health <= 0 or not root then break end

        local camera = workspace.CurrentCamera
        if camera then
            root.AssemblyLinearVelocity =
                camera.CFrame.LookVector * DASH_SPEED
        end

        RunService.Heartbeat:Wait()
    end

    dashActive = false
    if humanoid then
        humanoid.WalkSpeed = running and RUN_SPEED or WALK_SPEED
    end
end

local function toggleRun()
    if not humanoid or dashActive then return end

    running = not running
    humanoid.WalkSpeed = running and RUN_SPEED or WALK_SPEED

    if running then
        stopTrack("Walk")
        playTrack("Run")
    else
        stopTrack("Run")
        if humanoid.MoveDirection.Magnitude > 0 then
            playTrack("Walk")
        else
            playTrack("Idle")
        end
    end
end

local function stopMusic()
    musicOn = false
    if music then
        music:Stop()
        music:Destroy()
        music = nil
    end
end

local function toggleCrackedEmpire(button)
    if musicOn then
        stopMusic()
        button.Text = "CRACKED EMPIRE: OFF"
        return
    end

    music = Instance.new("Sound")
    music.Name = "CrackedEmpireMusic"
    music.SoundId = "rbxassetid://" .. IDS.CrackedEmpire
    music.Volume = 0.8
    music.Looped = true
    music.Parent = playerGui

    musicOn = true
    button.Text = "CRACKED EMPIRE: ON"
    music:Play()

    local current = music
    task.delay(3, function()
        if music == current then
            if not current.IsLoaded then
                warn("Cracked Empire audio is not loaded. Check Output and audio permissions.")
            end
        end
    end)
end


-- Keyboard controls
UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.LeftShift then
        if not running then toggleRun() end
    elseif input.KeyCode == Enum.KeyCode.Q then
        toggleRun()
    elseif input.KeyCode == Enum.KeyCode.E then
        activateShield()
    elseif input.KeyCode == Enum.KeyCode.R then
        shieldStrike()
    elseif input.KeyCode == Enum.KeyCode.F then
        task.spawn(dash)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.LeftShift and running then
        toggleRun()
    end
end)

-- Movement animations
RunService.Heartbeat:Connect(function()
    if not humanoid or humanoid.Health <= 0 or dashActive then return end

    local state = humanoid:GetState()

    if state == Enum.HumanoidStateType.Jumping
        or state == Enum.HumanoidStateType.Freefall then
        stopTrack("Idle")
        stopTrack("Walk")
        stopTrack("Run")

        if state == Enum.HumanoidStateType.Jumping then
            playTrack("Jump")
        else
            stopTrack("Jump")
            playTrack("Fall")
        end
    elseif humanoid.MoveDirection.Magnitude > 0.05 then
        stopTrack("Idle")
        stopTrack("Jump")
        stopTrack("Fall")

        if running then
            stopTrack("Walk")
            playTrack("Run")
        else
            stopTrack("Run")
            playTrack("Walk")
        end
    else
        stopTrack("Walk")
        stopTrack("Run")
        stopTrack("Jump")
        stopTrack("Fall")
        playTrack("Idle")
    end
end)

-- Double jump
humanoid = humanoid or (character and character:FindFirstChildOfClass("Humanoid"))

UIS.JumpRequest:Connect(function()
    if not humanoid or not root then return end

    if humanoid:GetState() == Enum.HumanoidStateType.Freefall
        and not doubleJumpUsed then

        doubleJumpUsed = true
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        root.AssemblyLinearVelocity = Vector3.new(
            root.AssemblyLinearVelocity.X,
            55,
            root.AssemblyLinearVelocity.Z
        )

        playSound(IDS.DoubleJump, root)

        local smoke = Instance.new("ParticleEmitter")
        smoke.Name = "EggmanDoubleJumpSmoke"
        smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
        smoke.Color = ColorSequence.new(Color3.new(1, 1, 1))
        smoke.Lifetime = NumberRange.new(0.25, 0.5)
        smoke.Speed = NumberRange.new(3, 7)
        smoke.Rate = 0
        smoke.SpreadAngle = Vector2.new(180, 180)
        smoke.Parent = root
        smoke:Emit(24)
        Debris:AddItem(smoke, 1)
    end
end)

local function connectLanding()
    if not humanoid then return end

    humanoid.StateChanged:Connect(function(_, newState)
        if newState == Enum.HumanoidStateType.Landed
            or newState == Enum.HumanoidStateType.Running then
            doubleJumpUsed = false
        end
    end)
end

if humanoid then connectLanding() end


local IDS = {
    Shield = "121620484878674",
    Retract = "101024228616428",
    Strike = "107417919520477",
    DoubleJump = "94415781170273",
    Jetpack = "126742809369490",
    CrackedEmpire = "87493231115640",
}

local ANIMS = {
    Idle = "126850823844164",
    Walk = "90633769714545",
    Run = "139037627723405",
    Jump = "75242449879123",
    Fall = "140113712768097",
    Dash = "76911383572824",
}

local WALK_SPEED = 6
local RUN_SPEED = 25
local DASH_SPEED = 75
local DASH_TIME = 3
local SHIELD_TIME = 5

local character, humanoid, root
local animator
local tracks = {}
local running = false
local shieldActive = false
local shieldToken = 0
local shieldPart
local music
local musicOn = false
local doubleJumpUsed = false
local dashActive = false

local function setupCharacter(char)
    character = char
    humanoid = char:WaitForChild("Humanoid")
    root = char:WaitForChild("HumanoidRootPart")
    animator = humanoid:WaitForChild("Animator")

    tracks = {}
    for name, id in pairs(ANIMS) do
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. id
        local ok, track = pcall(function()
            return animator:LoadAnimation(anim)
        end)
        if ok and track then
            tracks[name] = track
        end
    end

    humanoid.WalkSpeed = WALK_SPEED
    shieldActive = false
    shieldToken += 1
    shieldPart = nil
    doubleJumpUsed = false
    dashActive = false
end

if player.Character then
    setupCharacter(player.Character)
end

player.CharacterAdded:Connect(setupCharacter)

local function playSound(id, parent, looped, volume)
    if not parent then return end

    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://" .. id
    sound.Volume = volume or 1
    sound.Looped = looped or false
    sound.Parent = parent
    sound:Play()

    if not looped then
        Debris:AddItem(sound, 30)
    end

    return sound
end

local function stopTrack(name)
    if tracks[name] and tracks[name].IsPlaying then
        tracks[name]:Stop(0.1)
    end
end

local function playTrack(name)
    local track = tracks[name]
    if track and not track.IsPlaying then
        track:Play(0.15)
    end
end

local function stopMovementTracks()
    for _, name in ipairs({"Idle", "Walk", "Run", "Jump", "Fall", "Dash"}) do
        stopTrack(name)
    end
end


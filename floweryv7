-- Full movement freeze
local frozen = false
local saved = nil

local function freeze(on)
    local h = humanoid()
    if not h then return end

    if on and not frozen then
        frozen = true
        saved = {
            WalkSpeed = h.WalkSpeed,
            JumpPower = h.JumpPower,
            JumpHeight = h.JumpHeight,
            AutoRotate = h.AutoRotate,
        }
        h.WalkSpeed = 0
        h.JumpPower = 0
        h.JumpHeight = 0
        h.AutoRotate = false
        h:Move(Vector3.zero)
    elseif not on and frozen then
        frozen = false
        if saved then
            h.WalkSpeed = saved.WalkSpeed
            h.JumpPower = saved.JumpPower
            h.JumpHeight = saved.JumpHeight
            h.AutoRotate = saved.AutoRotate
        end
        saved = nil
    end
end

-- Rainbow character glow during Omega
local omegaActive = false
local glow
local rainbowConnection

local function startRainbow()
    local c = character()
    if not c then return end

    if glow then glow:Destroy() end
    glow = Instance.new("Highlight")
    glow.FillTransparency = 0.25
    glow.OutlineTransparency = 0
    glow.Parent = c

    local hue = 0
    if rainbowConnection then rainbowConnection:Disconnect() end
    rainbowConnection = RunService.Heartbeat:Connect(function(dt)
        if not omegaActive or not glow or not glow.Parent then return end
        hue = (hue + dt * 0.7) % 1
        local color = Color3.fromHSV(hue, 1, 1)
        glow.FillColor = color
        glow.OutlineColor = color
    end)
end

local function stopRainbow()
    if rainbowConnection then
        rainbowConnection:Disconnect()
        rainbowConnection = nil
    end
    if glow then
        glow:Destroy()
        glow = nil
    end
end

-- Rainbow run afterimages
local cloneFolder
local clonesEnabled = false
local cloneHue = 0

local function makeClone()
    local c = character()
    if not c then return end

    if not cloneFolder or not cloneFolder.Parent then
        cloneFolder = Instance.new("Folder")
        cloneFolder.Name = "FloweryRainbowClones"
        cloneFolder.Parent = workspace
    end

    local oldArchivable = c.Archivable
    c.Archivable = true
    local clone = c:Clone()
    c.Archivable = oldArchivable
    if not clone then return end

    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("Script") or obj:IsA("LocalScript")
            or obj:IsA("Tool") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.Anchored = true
            obj.CanCollide = false
            obj.CanTouch = false
            obj.CanQuery = false
            obj.Material = Enum.Material.Neon
            obj.Transparency = math.max(obj.Transparency, 0.35)
        end
    end

    clone.Name = "FloweryRainbowClone"
    clone.Parent = cloneFolder

    cloneHue = (cloneHue + 0.12) % 1
    local color = Color3.fromHSV(cloneHue, 1, 1)

    for _, obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.Color = color
            TweenService:Create(
                obj,
                TweenInfo.new(0.45),
                {Transparency = 1}
            ):Play()
        end
    end

    task.delay(0.5, function()
        if clone then clone:Destroy() end
    end)
end

local function startClones()
    if clonesEnabled then return end
    clonesEnabled = true
    task.spawn(function()
        while clonesEnabled do
            makeClone()
            task.wait(0.12)
        end
    end)
end

local function stopClones()
    clonesEnabled = false
    if cloneFolder then
        cloneFolder:Destroy()
        cloneFolder = nil
    end
end

-- Run: 5 seconds, then 6-second cooldown
local running = false
local runReady = true
local runButton

local function run()
    if running or not runReady or frozen then return end
    local h = humanoid()
    if not h then return end

    running = true
    runReady = false
    local previousSpeed = h.WalkSpeed

    h.WalkSpeed = omegaActive and OMEGA_RUN_SPEED or RUN_SPEED
    sound(RUN_SOUND, false)
    startClones()

    for i = RUN_TIME, 1, -1 do
        if runButton then
            runButton.Text = "Бег: " .. i .. " сек"
        end
        task.wait(1)
    end

    stopClones()
    h = humanoid()
    if h then
        h.WalkSpeed = omegaActive and OMEGA_SPEED or previousSpeed
    end
    running = false

    for i = RUN_COOLDOWN, 1, -1 do
        if runButton then
            runButton.Text = "Кулдаун: " .. i
        end
        task.wait(1)
    end

    runReady = true
    if runButton then runButton.Text = "Бег [Q]" end
end

local function jarona()
    if frozen then return end
    local h, r = humanoid(), root()
    if not h or not r then return end

    local oldSpeed = h.WalkSpeed
    h.WalkSpeed = 0
    sound(SFX.Jarona, false)
    makeClone()
    r.AssemblyLinearVelocity = r.CFrame.LookVector * 120

    task.wait(0.4)
    h = humanoid()
    if h then
        h.WalkSpeed = omegaActive and OMEGA_SPEED or oldSpeed
    end
end

-- Omega toggles on/off; freeze only while Omega sound plays
local omegaBusy = false
local function omega()
    if omegaBusy or frozen then return end
    omegaBusy = true

    omegaActive = true
    startRainbow()
    local h = humanoid()
    if h then h.WalkSpeed = OMEGA_SPEED end

    freeze(true)
    local s = sound(SFX.Omega, false)
    if s then
        s.Ended:Wait()
    else
        task.wait(3)
    end
    freeze(false)

    omegaBusy = false
end

-- Last Jarona can only be charged during Omega
local charging = false
local chargeStart = 0
local chargeButton
local chargeSound

local function startCharge()
    if not omegaActive or charging or frozen or omegaBusy then return end
    charging = true
    chargeStart = os.clock()
    freeze(true)

    chargeSound = sound(SFX.Charge, false)
    if chargeButton then chargeButton.Text = "Зарядка: 0.000" end

    task.spawn(function()
        while charging do
            local elapsed = math.min(os.clock() - chargeStart, MAX_CHARGE)
            if chargeButton then
                chargeButton.Text = string.format("Зарядка: %.3f", elapsed)
            end
            if elapsed >= MAX_CHARGE then break end
            task.wait(0.01)
        end
    end)
end

local function releaseCharge()
    if not charging then return end
    charging = false

    local elapsed = math.clamp(os.clock() - chargeStart, 0, MAX_CHARGE)
    freeze(false)

    if chargeSound then
        chargeSound:Stop()
        chargeSound:Destroy()
        chargeSound = nil
    end

    sound(SFX.LastJarona, false)
    local r = root()
    if r then
        makeClone()
        r.AssemblyLinearVelocity = r.CFrame.LookVector * (80 + elapsed * 100)
    end

    if chargeButton then chargeButton.Text = "Last Jarona [F]" end
end

runButton = makeButton("Бег [Q]", 8, function()
    task.spawn(run)
end)

makeButton("Jarona [E]", 58, function()
    task.spawn(jarona)
end)

makeButton("Omega [G]", 108, function()
    task.spawn(omega)
end)

chargeButton = makeButton("Last Jarona [F]", 158, function()
    if charging then
        releaseCharge()
    else
        startCharge()
    end
end)

-- Spawn, music and death sounds
local musicSound
local function setupCharacter(c)
    task.wait(1)
    if not c.Parent then return end

    sound(SFX.Spawn, false)

    if musicSound then
        musicSound:Destroy()
        musicSound = nil
    end

    local r = c:FindFirstChild("HumanoidRootPart")
    local h = c:FindFirstChildOfClass("Humanoid")

    if r then
        musicSound = Instance.new("Sound")
        musicSound.SoundId = "rbxassetid://" .. SFX.Music
        musicSound.Volume = 0.5
        musicSound.Looped = true
        musicSound.Parent = r
        musicSound:Play()
    end

    if h then
        h.Died:Connect(function()
            stopClones()
            stopRainbow()
            omegaActive = false
            if musicSound then
                musicSound:Stop()
                musicSound:Destroy()
                musicSound = nil
            end
            sound(SFX.Death, false)
        end)
    end
end

player.CharacterAdded:Connect(setupCharacter)
if player.Character then
    task.spawn(setupCharacter, player.Character)
end

-- Keyboard controls
UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.Q then
        task.spawn(run)
    elseif input.KeyCode == Enum.KeyCode.E then
        task.spawn(jarona)
    elseif input.KeyCode == Enum.KeyCode.G then
        task.spawn(omega)
    elseif input.KeyCode == Enum.KeyCode.F then
        startCharge()
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.F then
        releaseCharge()
    end
end)

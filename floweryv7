-- FLOWERY v7 — Delta
-- Q = Run | E = Jarona | G = Omega | Hold F = Last Jarona charge

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local RUN_TIME, RUN_COOLDOWN = 5, 6
local MAX_CHARGE = 3

local SFX = {
    Death = "98744900859001",
    Omega = "73270882643839",
    Jarona = "95260980013578",
    LastJarona = "132304008738886",
    Charge = "83448418187528",
    Spawn = "132676315734244",
    Music = "70963803115381",
}

local RUN_SOUND = "108424972802128"
local NORMAL_SPEED = 16
local RUN_SPEED = 500
local OMEGA_SPEED = 40
local OMEGA_RUN_SPEED = 1000

local function character()
    return player.Character
end

local function humanoid()
    local c = character()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function root()
    local c = character()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function sound(id, looped)
    local r = root()
    if not r then return nil end

    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. id
    s.Volume = 1
    s.Looped = looped or false
    s.Parent = r
    s:Play()

    if not s.Looped then
        s.Ended:Connect(function()
            s:Destroy()
        end)
    end
    return s
end


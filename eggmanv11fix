-- Character setup
local function setupCharacter(newCharacter)
    character = newCharacter
    humanoid = character:WaitForChild("Humanoid")
    root = character:WaitForChild("HumanoidRootPart")

    animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    tracks = {}
    for name, id in pairs(CONFIG.Animations) do
        loadTrack(name, id)
    end

    humanoid.WalkSpeed = CONFIG.WalkSpeed

    music = Instance.new("Sound")
    music.Name = "EggmanMusic"
    music.Volume = 0.65
    music.Looped = true
    music.Parent = root

    local jumpSound = Instance.new("Sound")
    jumpSound.Name = "EggmanDoubleJump"
    jumpSound.SoundId = CONFIG.DoubleJumpSound
    jumpSound.Volume = 1
    jumpSound.Parent = root

    jumpsUsed = 0
    running = false
    jetActive = false
    runButton.Text = "RUN  •  OFF"

    humanoid.StateChanged:Connect(function(_, state)
        if state == Enum.HumanoidStateType.Landed then
            jumpsUsed = 0
            stopTrack("Fall")
        elseif state == Enum.HumanoidStateType.Freefall then
            playTrack("Fall")
        end
    end)

    humanoid.Running:Connect(function(speed)
        if not humanoid or humanoid.Health <= 0 then return end

        if speed > 0.5 then
            stopTrack("Idle")
            if running then
                stopTrack("Walk")
                playTrack("Run")
            else
                stopTrack("Run")
                playTrack("Walk")
            end
        else
            stopTrack("Walk")
            stopTrack("Run")
            if humanoid.FloorMaterial ~= Enum.Material.Air then
                playTrack("Idle")
            end
        end
    end)

    humanoid.Jumping:Connect(function(active)
        if active then playTrack("Jump") end
    end)

    -- Genuine second jump: first jump is the normal Humanoid jump.
    local jumpConnection
    jumpConnection = UIS.JumpRequest:Connect(function()
        if not humanoid or humanoid.Health <= 0 then return end

        if humanoid.FloorMaterial ~= Enum.Material.Air then
            jumpsUsed = 1
            return
        end

        if jumpsUsed < 1 then
            jumpsUsed = 1
        elseif jumpsUsed == 1 then
            jumpsUsed = 2

            root.AssemblyLinearVelocity = Vector3.new(
                root.AssemblyLinearVelocity.X,
                CONFIG.DoubleJumpPower,
                root.AssemblyLinearVelocity.Z
            )

            jumpSound:Play()
            playTrack("Jump")
            smokeFromFoot("Left Leg")
            smokeFromFoot("Right Leg")
        end
    end)

    humanoid.Died:Connect(function()
        if jumpConnection then
            jumpConnection:Disconnect()
        end
        if shield then
            shield:Destroy()
            shield = nil
            shieldActive = false
        end
        if music then music:Stop() end
    end)
end

player.CharacterAdded:Connect(setupCharacter)
if player.Character then

-- Sound and animation helpers
local function loadTrack(name, id)
    if not animator then return end

    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://" .. id

    local success, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    if success and track then
        tracks[name] = track
        if name == "Idle" then
            track.Priority = Enum.AnimationPriority.Idle
        else
            track.Priority = Enum.AnimationPriority.Movement
        end
        track.Looped = name ~= "Jump"
    end
end

local function playTrack(name)
    local track = tracks[name]
    if track and not track.IsPlaying then
        track:Play(0.12)
    end
end

local function stopTrack(name)
    local track = tracks[name]
    if track and track.IsPlaying then
        track:Stop(0.12)
    end
end

local function smokeFromFoot(name)
    local foot = character and character:FindFirstChild(name)
    if not foot then return end

    local attachment = Instance.new("Attachment")
    attachment.Position = Vector3.new(0, -foot.Size.Y / 2, 0)
    attachment.Parent = foot

    local emitter = Instance.new("ParticleEmitter")
    emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
    emitter.Rate = 0
    emitter.Lifetime = NumberRange.new(0.3, 0.5)
    emitter.Speed = NumberRange.new(2, 4)
    emitter.SpreadAngle = Vector2.new(25, 25)
    emitter.Size = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.5),
        NumberSequenceKeypoint.new(1, 0)
    })
    emitter.Parent = attachment
    emitter:Emit(1)

    task.delay(1, function()
        if attachment.Parent then
            attachment:Destroy()
        end
    end)
end

local function makeStarBurst()
    if not root then return end

    for _, footName in ipairs({"Left Leg", "Right Leg"}) do
        local foot = character:FindFirstChild(footName)
        if foot then
            local spark = Instance.new("ParticleEmitter")
            spark.Texture = "rbxasset://textures/particles/sparkles_main.dds"
            spark.Rate = 0
            spark.Lifetime = NumberRange.new(0.2, 0.45)
            spark.Speed = NumberRange.new(3, 7)
            spark.SpreadAngle = Vector2.new(45, 45)
            spark.Parent = foot
            spark:Emit(8)
            task.delay(1, function()
                if spark.Parent then spark:Destroy() end
            end)
        end
    end
end

local function createRings(position)
    for i = 1, 3 do
        local ring = Instance.new("Part")
        ring.Name = "EggmanShieldRing"
        ring.Shape = Enum.PartType.Cylinder
        ring.Material = Enum.Material.Neon
        ring.Color = Color3.fromRGB(0, 190, 255)
        ring.Transparency = 0.1
        ring.Anchored = true
        ring.CanCollide = false
        ring.CanTouch = false
        ring.CanQuery = false
        ring.Size = Vector3.new(0.12, 1, 1)
        ring.CFrame = CFrame.new(position + Vector3.new(0, i * 0.12, 0))
            * CFrame.Angles(0, 0, math.rad(90))
        ring.Parent = workspace

        local tween = TweenService:Create(
            ring,
            TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {
                Size = Vector3.new(0.12, 12, 12),
                Transparency = 1
            }
        )
        tween:Play()
        tween.Completed:Connect(function()
            ring:Destroy()
        end)
    end
end

local function flashWhiteTwice()
    if not character then return end

    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.new(1, 1, 1)
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.15
    highlight.OutlineTransparency = 1
    highlight.Parent = character

    for _ = 1, 2 do
        highlight.Enabled = true
        task.wait(0.12)
        highlight.Enabled = false
        task.wait(0.12)
    end

    highlight:Destroy()
end

-- Shield visuals
local function removeShield(exploded)
    if not shield then return end

    local sphere = shield
    local position = sphere.Position
    shield = nil
    shieldActive = false
    shieldButton.Text = "ENERGY SHIELD  •  OFF"

    if exploded then
        -- Sphere remains for half a second after the burst.
        task.wait(0.5)
        if sphere.Parent then sphere:Destroy() end
        createRings(position)
    else
        local tween = TweenService:Create(
            sphere,
            TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            {
                Size = Vector3.new(0.1, 0.1, 0.1),
                Transparency = 1
            }
        )
        tween:Play()
        tween.Completed:Wait()
        if sphere.Parent then sphere:Destroy() end
        flashWhiteTwice()
    end
end

local function toggleShield()
    if not character or not root then return end

    if shieldActive and shield then
        shieldToken += 1
        shieldActive = false
        shieldButton.Text = "ENERGY SHIELD  •  EXPLODING"

        local burst = Instance.new("Explosion")
        burst.Position = shield.Position
        burst.BlastRadius = 0
        burst.BlastPressure = 0
        burst.DestroyJointRadiusPercent = 0
        burst.Parent = workspace

        task.spawn(function()
            removeShield(true)
        end)
        return
    end

    shieldToken += 1
    local token = shieldToken
    shieldActive = true

    local sphere = Instance.new("Part")
    sphere.Name = "EggmanGlassShield"
    sphere.Shape = Enum.PartType.Ball
    sphere.Size = Vector3.new(0.1, 0.1, 0.1)
    sphere.Material = Enum.Material.Glass
    sphere.Color = Color3.fromRGB(95, 205, 255)
    sphere.Transparency = 0.35
    sphere.Anchored = false
    sphere.Massless = true
    sphere.CanCollide = false
    sphere.CanTouch = false
    sphere.CanQuery = false
    sphere.CFrame = root.CFrame
    sphere.Parent = character

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = sphere
    weld.Parent = sphere

    shield = sphere
    shieldButton.Text = "ENERGY SHIELD  •  ON"

    TweenService:Create(
        sphere,
        TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {
            Size = Vector3.new(
                CONFIG.ShieldDiameter,
                CONFIG.ShieldDiameter,
                CONFIG.ShieldDiameter
            )
        }
    ):Play()

    task.delay(CONFIG.ShieldDuration, function()
        if shield == sphere and shieldToken == token and shieldActive then
            removeShield(false)
        end
    end)
end


-- WHITE RINGS: torus mesh, animated and automatically removed
local function createWhiteRing(position)
    local ring = Instance.new("Part")
    ring.Name = "EggmanWhiteRing"
    ring.Size = Vector3.new(1, 1, 1)
    ring.Anchored = true
    ring.CanCollide = false
    ring.CanTouch = false
    ring.CanQuery = false
    ring.Transparency = 0.05
    ring.Material = Enum.Material.Neon
    ring.Color = Color3.new(1, 1, 1)
    ring.CFrame = CFrame.new(position)
    ring.Parent = workspace

    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Torus
    mesh.Scale = Vector3.new(1, 0.3, 1)
    mesh.Parent = ring

    local start = os.clock()
    local duration = 0.7
    local connection

    connection = RunService.Heartbeat:Connect(function()
        if not ring.Parent then
            connection:Disconnect()
            return
        end

        local alpha = math.clamp((os.clock() - start) / duration, 0, 1)
        local diameter = 2 + 18 * alpha

        ring.Size = Vector3.new(diameter, diameter, diameter)
        ring.CFrame = CFrame.new(position)
        ring.Transparency = 0.05 + 0.95 * alpha

        if alpha >= 1 then
            connection:Disconnect()
            ring:Destroy()
        end
    end)

    Debris:AddItem(ring, 1.2)
end

local function shieldStrike()
    if not shieldActive or not root then return end

    playSound(IDS.Strike, root)
    blueShockwave()

    shieldToken += 1
    local token = shieldToken

    task.delay(0.2, function()
        if token ~= shieldToken then return end

        shieldActive = false
        destroyShield()

        local position = root.Position

        for i = 1, 3 do
            task.delay((i - 1) * 0.2, function()
                createWhiteRing(position)
            end)
        end
    end)
end


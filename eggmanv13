-- WASD tracking for camera-relative dash
table.clear(heldKeys)

table.insert(characterConnections, UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.W then heldKeys.W = true end
    if input.KeyCode == Enum.KeyCode.A then heldKeys.A = true end
    if input.KeyCode == Enum.KeyCode.S then heldKeys.S = true end
    if input.KeyCode == Enum.KeyCode.D then heldKeys.D = true end

    if input.KeyCode == Enum.KeyCode.LeftShift
        or input.KeyCode == Enum.KeyCode.RightShift then
        running = true
        if humanoid then humanoid.WalkSpeed = RUN_SPEED end
    end
end))

table.insert(characterConnections, UIS.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then heldKeys.W = false end
    if input.KeyCode == Enum.KeyCode.A then heldKeys.A = false end
    if input.KeyCode == Enum.KeyCode.S then heldKeys.S = false end
    if input.KeyCode == Enum.KeyCode.D then heldKeys.D = false end

    if input.KeyCode == Enum.KeyCode.LeftShift
        or input.KeyCode == Enum.KeyCode.RightShift then
        running = false
        if humanoid then humanoid.WalkSpeed = WALK_SPEED end
    end
end))

-- Double jump: real second jump, not just a sound.
local jumpCount = 0
local canDoubleJump = true

local function onJumpRequest()
    if not humanoid or not root or dashActive then return end

    local state = humanoid:GetState()
    local grounded = state == Enum.HumanoidStateType.Running
        or state == Enum.HumanoidStateType.RunningNoPhysics
        or state == Enum.HumanoidStateType.Landed

    if grounded then
        jumpCount = 1
        canDoubleJump = true
        return
    end

    if jumpCount == 1 and canDoubleJump then
        canDoubleJump = false
        jumpCount = 2

        playSound(IDS.DoubleJump, root)
        stopTrack("Fall")
        playTrack("Jump", false)

        -- Real second jump, preserving horizontal momentum.
        local currentVelocity = root.AssemblyLinearVelocity
        local jumpVelocity

        if humanoid.UseJumpPower then
            jumpVelocity = humanoid.JumpPower
        else
            jumpVelocity = math.sqrt(2 * workspace.Gravity * humanoid.JumpHeight)
        end

        root.AssemblyLinearVelocity = Vector3.new(
            currentVelocity.X,
            jumpVelocity,
            currentVelocity.Z
        )
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end

table.insert(characterConnections, UIS.JumpRequest:Connect(onJumpRequest))

table.insert(characterConnections, humanoid.StateChanged:Connect(function(_, state)
    if state == Enum.HumanoidStateType.Landed
        or state == Enum.HumanoidStateType.Running then
        jumpCount = 0
        canDoubleJump = true
        stopTrack("Fall")
    elseif state == Enum.HumanoidStateType.Freefall then
        if not dashActive then playTrack("Fall", true) end
    end
end))

-- Basic animation switching
table.insert(characterConnections, RunService.Heartbeat:Connect(function()
    if not humanoid or dashActive then return end

    if humanoid.MoveDirection.Magnitude > 0.05 then
        if running then
            if tracks.Run and not tracks.Run.IsPlaying then
                stopTrack("Walk")
                stopTrack("Idle")
                playTrack("Run", true)
            end
        else
            if tracks.Walk and not tracks.Walk.IsPlaying then
                stopTrack("Run")
                stopTrack("Idle")
                playTrack("Walk", true)
            end
        end
    else
        stopTrack("Walk")
        stopTrack("Run")
        if tracks.Idle and not tracks.Idle.IsPlaying then
            playTrack("Idle", true)
        end
    end
end))

-- Respawn cleanup and reinitialization
player.CharacterAdded:Connect(function(char)
    shieldToken += 1
    shieldActive = false
    destroyShield()

    if dashConnection then
        dashConnection:Disconnect()
        dashConnection = nil
    end
    dashActive = false

    if music then
        music:Stop()
        music:Destroy()
        music = nil
        musicName = nil
    end

    setupCharacter(char)

    -- Reconnect character-specific jump and animation handlers.
    table.insert(characterConnections, humanoid.StateChanged:Connect(function(_, state)
        if state == Enum.HumanoidStateType.Landed
            or state == Enum.HumanoidStateType.Running then
            jumpCount = 0
            canDoubleJump = true
            stopTrack("Fall")
        elseif state == Enum.HumanoidStateType.Freefall then
            if not dashActive then playTrack("Fall", true) end
        end
    end))

    playTrack("Idle", true)
end)


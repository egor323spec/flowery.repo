end

local function dashDirection()
    local camera = workspace.CurrentCamera
    if not camera then return Vector3.new(0, 0, -1) end

    -- Camera-relative horizontal WASD movement.
    local look = camera.CFrame.LookVector
    local right = camera.CFrame.RightVector

    local forward = Vector3.new(look.X, 0, look.Z)
    local sideways = Vector3.new(right.X, 0, right.Z)

    if forward.Magnitude > 0 then forward = forward.Unit end
    if sideways.Magnitude > 0 then sideways = sideways.Unit end

    local direction = Vector3.zero

    if heldKeys.W then direction += forward end
    if heldKeys.S then direction -= forward end
    if heldKeys.D then direction += sideways end
    if heldKeys.A then direction -= sideways end

    -- If no WASD key is held, dash toward the camera's horizontal facing.
    if direction.Magnitude < 0.01 then
        direction = forward
    end

    if direction.Magnitude < 0.01 then
        direction = Vector3.new(0, 0, -1)
    end

    return direction.Unit
end

local function jetpackDash()
    if dashActive or not root or not humanoid then return end

    dashActive = true
    playSound(IDS.Jetpack, root)
    playTrack("Dash", true)

    local particles = createDashParticles()

    local attachment = Instance.new("Attachment")
    attachment.Name = "EggmanDashVelocityAttachment"
    attachment.Parent = root

    local velocity = Instance.new("LinearVelocity")
    velocity.Name = "EggmanDashVelocity"
    velocity.Attachment0 = attachment
    velocity.RelativeTo = Enum.ActuatorRelativeTo.World
    velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    velocity.MaxForce = 1000000
    velocity.Parent = root

    local started = os.clock()
    local initialY = root.AssemblyLinearVelocity.Y

    dashConnection = RunService.Heartbeat:Connect(function()
        if not dashActive or not root or not root.Parent then return end

        -- Direction updates with WASD and camera.
        -- Vertical velocity is preserved: no flying up or down with camera pitch.
        local direction = dashDirection()
        velocity.VectorVelocity = Vector3.new(
            direction.X * DASH_SPEED,
            initialY,
            direction.Z * DASH_SPEED
        )

        if os.clock() - started >= DASH_TIME then
            if dashConnection then
                dashConnection:Disconnect()
                dashConnection = nil
            end
        end
    end)

    task.wait(DASH_TIME)

    if dashConnection then
        dashConnection:Disconnect()
        dashConnection = nil
    end

    if velocity then velocity:Destroy() end
    if attachment then attachment:Destroy() end

    if particles and particles.Parent then
        for _, child in ipairs(particles:GetChildren()) do
            if child:IsA("ParticleEmitter") then
                child.Enabled = false
            end
        end
        Debris:AddItem(particles, 2)
    end

    stopTrack("Dash")
    dashActive = false
end


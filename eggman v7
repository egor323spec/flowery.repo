local function makeButton(text, y, color, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -24, 0, 36)
    button.Position = UDim2.new(0, 12, 0, y)
    button.BackgroundColor3 = color
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 12
    button.Text = text
    button.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = button

    button.Activated:Connect(callback)
    return button
end

-- ENERGY SHIELD
local shieldActive = false

local function activateShield()
    if shieldActive then return end

    local root = getRoot()
    if not root then return end

    shieldActive = true

    local shield = Instance.new("Part")
    shield.Name = "EggmanEnergyShield"
    shield.Shape = Enum.PartType.Ball
    shield.Size = Vector3.new(0.2, 0.2, 0.2)
    shield.Material = Enum.Material.ForceField
    shield.Color = Color3.fromRGB(0, 200, 255)
    shield.Transparency = 0.3
    shield.CanCollide = false
    shield.Anchored = false
    shield.Massless = true
    shield.CFrame = root.CFrame
    shield.Parent = workspace

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = shield
    weld.Parent = shield

    TweenService:Create(
        shield,
        TweenInfo.new(0.25),
        {Size = Vector3.new(10, 10, 10)}
    ):Play()

    playSound(IDS.Shield, false, 1)

    task.delay(SHIELD_DURATION - 0.5, function()
        if shield.Parent then
            TweenService:Create(
                shield,
                TweenInfo.new(0.5),
                {
                    Size = Vector3.new(0.2, 0.2, 0.2),
                    Transparency = 1
                }
            ):Play()

            task.wait(0.5)
            if shield.Parent then shield:Destroy() end
        end

        shieldActive = false
    end)
end

-- JETPACK BOOST
local jetpackActive = false

local function activateJetpack()
    if jetpackActive then return end

    local character = getCharacter()
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then return end

    jetpackActive = true
    local oldSpeed = humanoid.WalkSpeed

    local attachment = Instance.new("Attachment")
    attachment.Parent = root

    local particles = Instance.new("ParticleEmitter")
    particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    particles.Color = ColorSequence.new(Color3.new(1, 1, 1))
    particles.Rate = 100
    particles.Lifetime = NumberRange.new(0.2, 0.5)
    particles.Speed = NumberRange.new(5, 12)
    particles.Parent = attachment

    humanoid.WalkSpeed = 100
    playSound(IDS.Jetpack, false, 1)

    task.delay(JETPACK_DURATION, function()
        if humanoid.Parent then
            humanoid.WalkSpeed = oldSpeed
        end

        if attachment.Parent then
            attachment:Destroy()
        end

        jetpackActive = false
    end)
end

-- AUTO HACKERPACK
-- Alternates the local boost state for 3 seconds.
-- Connect setHackerpackEnabled to your own game's
-- legitimate server-side ability implementation.

local autoHackerpackActive = false
local hackerpackEnabled = false

local function setHackerpackEnabled(enabled)
    hackerpackEnabled = enabled

    -- Insert your own project's ability toggle here.
    -- This placeholder does not trigger a server ability.
end

local function autoHackerpackBoost()
    if autoHackerpackActive then return end

    autoHackerpackActive = true
    local started = os.clock()

    task.spawn(function()
        while autoHackerpackActive
            and os.clock() - started < AUTO_BOOST_DURATION do

            setHackerpackEnabled(true)
            task.wait(AUTO_BOOST_INTERVAL)

            setHackerpackEnabled(false)
            task.wait(AUTO_BOOST_INTERVAL)
        end

        setHackerpackEnabled(false)
        autoHackerpackActive = false
    end)
end

-- SHIELD HIT VISUAL
local function shieldHit()
    local root = getRoot()
    if not root then return end

    local wave = Instance.new("Part")
    wave.Name = "EggmanShieldWave"
    wave.Shape = Enum.PartType.Ball
    wave.Size = Vector3.new(1, 1, 1)
    wave.Material = Enum.Material.Neon
    wave.Color = Color3.fromRGB(0, 220, 255)
    wave.Transparency = 0.25
    wave.Anchored = true
    wave.CanCollide = false
    wave.CFrame = root.CFrame
    wave.Parent = workspace

    local size = SHIELD_RADIUS * 4

    TweenService:Create(
        wave,
        TweenInfo.new(0.45),
        {
            Size = Vector3.new(size, size, size),
            Transparency = 1
        }
    ):Play()

    playSound(IDS.Explosion, false, 1)

    task.delay(0.5, function()
        if wave.Parent then wave:Destroy() end
    end)
end

-- CRACKED EMPIRE
local music
local musicOn = false
local musicButton

local function toggleMusic()
    if musicOn then
        musicOn = false

        if music then
            music:Stop()
            music:Destroy()
            music = nil
        end

        musicButton.Text = "CRACKED EMPIRE: OFF"
    else
        musicOn = true
        music = playSound(IDS.CrackedEmpire, true, 1)
        musicButton.Text = "CRACKED EMPIRE: ON"
    end
end


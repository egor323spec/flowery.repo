local function makeButton(label, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 42)
    button.BackgroundColor3 = Color3.fromRGB(85, 45, 125)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.Text = label
    button.BorderSizePixel = 0
    button.Parent = list

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

    button.Activated:Connect(callback)
    return button
end

local shieldButton = makeButton("ENERGY SHIELD [E]", toggleShield)
local jetpackButton = makeButton("JETPACK BOOST [Q]", toggleJetpack)
local hitButton = makeButton("SHIELD HIT", shieldHit)
local musicButton = makeButton("CRACKED EMPIRE: OFF", toggleMusic)
local masterButton = makeButton("MASTER PLAN", playMasterPlan)
local closeButton = makeButton("CLOSE MENU", function()
    gui:Destroy()
end)

local function updateButton(button, enabled, name)
    button.Text = name .. (enabled and ": ON" or ": OFF")
end

shieldButton.Activated:Connect(function()
    task.defer(function()
        updateButton(shieldButton, shieldEnabled, "ENERGY SHIELD")
    end)
end)

jetpackButton.Activated:Connect(function()
    task.defer(function()
        updateButton(jetpackButton, jetpackEnabled, "JETPACK BOOST")
    end)
end)

musicButton.Activated:Connect(function()
    task.defer(function()
        updateButton(musicButton, musicEnabled, "CRACKED EMPIRE")
    end)
end)

player.CharacterAdded:Connect(function(char)
    shieldToken += 1
    jetpackToken += 1

    shieldEnabled = false
    jetpackEnabled = false
    shieldPart = nil
    jetpackAttachment = nil

    musicEnabled = false
    stopSound(musicSound)
    stopSound(masterPlanSound)
    musicSound = nil
    masterPlanSound = nil

    task.wait(0.5)
    setupCharacter(char)
end)

-- INPUT
UIS.InputBegan:Connect(function(input, processed)
    local key = input.KeyCode

    if key == Enum.KeyCode.W then heldKeys.W = true end
    if key == Enum.KeyCode.A then heldKeys.A = true end
    if key == Enum.KeyCode.S then heldKeys.S = true end
    if key == Enum.KeyCode.D then heldKeys.D = true end

    if processed then return end

    if key == Enum.KeyCode.LeftShift or key == Enum.KeyCode.RightShift then
        setRunning(true)
        runButton.Text = "RUN: ON"
    end
end)

UIS.InputEnded:Connect(function(input)
    local key = input.KeyCode

    if key == Enum.KeyCode.W then heldKeys.W = false end
    if key == Enum.KeyCode.A then heldKeys.A = false end
    if key == Enum.KeyCode.S then heldKeys.S = false end
    if key == Enum.KeyCode.D then heldKeys.D = false end

    if key == Enum.KeyCode.LeftShift or key == Enum.KeyCode.RightShift then
        setRunning(false)
        runButton.Text = "RUN: OFF"
    end
end)

-- DOUBLE JUMP
UIS.JumpRequest:Connect(function()
    if not humanoid or not root or dashActive or humanoid.Health <= 0 then
        return
    end

    if humanoid.FloorMaterial ~= Enum.Material.Air then
        jumpCount = 1
        canDoubleJump = true
        return
    end

    if jumpCount == 0 then jumpCount = 1 end

    if jumpCount == 1 and canDoubleJump then
        jumpCount = 2
        canDoubleJump = false

        playSound(IDS.DoubleJump, root)
        doubleJumpSmoke()

        stopTrack("Fall")
        playTrack("Jump", false)

        local jumpVelocity = humanoid.UseJumpPower
            and humanoid.JumpPower
            or math.sqrt(2 * workspace.Gravity * humanoid.JumpHeight)

        local v = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(v.X, jumpVelocity, v.Z)
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- CHARACTER SETUP
local function setupCharacter(char)
    for _, connection in ipairs(characterConnections) do
        connection:Disconnect()
    end
    table.clear(characterConnections)

    character = char
    humanoid = char:WaitForChild("Humanoid")
    root = char:WaitForChild("HumanoidRootPart")

    animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    if humanoid.RigType ~= Enum.HumanoidRigType.R6 then
        warn("Set Game Settings > Avatar > Avatar Type to R6.")
    end

    loadAnimations()
    jumpCount = 0
    canDoubleJump = true
    dashActive = false
    humanoid.WalkSpeed = running and RUN_SPEED or WALK_SPEED
    playTrack("Idle", true)

    table.insert(characterConnections, humanoid.StateChanged:Connect(function(_, state)
        if state == Enum.HumanoidStateType.Landed
            or state == Enum.HumanoidStateType.Running
            or state == Enum.HumanoidStateType.RunningNoPhysics then
            jumpCount = 0
            canDoubleJump = true
            stopTrack("Jump")
            stopTrack("Fall")
        elseif state == Enum.HumanoidStateType.Jumping then
            stopMovementTracks()
            playTrack("Jump", false)
        elseif state == Enum.HumanoidStateType.Freefall then
            stopTrack("Jump")
            playTrack("Fall", true)
        end
    end))
end

RunService.Heartbeat:Connect(function()
    if not humanoid or not humanoid.Parent or dashActive then return end

    local state = humanoid:GetState()
    if state == Enum.HumanoidStateType.Freefall
        or state == Enum.HumanoidStateType.Jumping then
        return
    end

    if humanoid.MoveDirection.Magnitude > 0.05 then
        if running then
            if tracks.Run and not tracks.Run.IsPlaying then
                stopMovementTracks()
                playTrack("Run", true)
            end
        elseif tracks.Walk and not tracks.Walk.IsPlaying then
            stopMovementTracks()
            playTrack("Walk", true)
        end
    elseif tracks.Idle and not tracks.Idle.IsPlaying then
        stopMovementTracks()
        playTrack("Idle", true)
    end
end)

player.CharacterAdded:Connect(function(char)
    shieldToken += 1
    shieldActive = false
    destroyShield()
    stopMusic()

    if dashConnection then
        dashConnection:Disconnect()
        dashConnection = nil
    end

    dashActive = false
    setupCharacter(char)
end)

setupCharacter(player.Character or player.CharacterAdded:Wait())
print("Eggman V16 loaded")

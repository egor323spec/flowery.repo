local function makeSound(id, parent, volume)
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. id
    s.Volume = volume or 1
    s.Parent = parent
    s:Play()
    s.Ended:Connect(function()
        s:Destroy()
    end)
    return s
end

local function loadAnimations()
    tracks = {}
    if not animator then return end

    for name, id in pairs(ANIMATIONS) do
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. id

        local ok, track = pcall(function()
            return animator:LoadAnimation(anim)
        end)

        if ok and track then
            tracks[name] = track
            if name == "Idle" then
                track.Priority = Enum.AnimationPriority.Idle
            elseif name == "Walk" or name == "Run" then
                track.Priority = Enum.AnimationPriority.Movement
            else
                track.Priority = Enum.AnimationPriority.Action
            end
        end
    end
end

local currentAnimation

local function playAnimation(name)
    local nextTrack = tracks[name]
    if not nextTrack or currentAnimation == name then return end

    for otherName, track in pairs(tracks) do
        if otherName ~= name and track.IsPlaying then
            track:Stop(0.15)
        end
    end

    currentAnimation = name
    if not nextTrack.IsPlaying then
        nextTrack:Play(0.15)
    end
end

local function stopMovementAnimations()
    for name, track in pairs(tracks) do
        if track.IsPlaying then
            track:Stop(0.1)
        end
    end
    currentAnimation = nil
end


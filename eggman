local function getCharacter()
    return player.Character
end

local function getRoot()
    local char = getCharacter()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function makeButton(text, y, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -24, 0, 42)
    button.Position = UDim2.fromOffset(12, y)
    button.BackgroundColor3 = Color3.fromRGB(65, 15, 20)
    button.TextColor3 = WHITE
    button.Text = text
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 8)
    c.Parent = button

    button.Activated:Connect(callback)
    return button
end

-- SHIELD
local shieldEnabled = false
local shieldVisual = nil

local function createShield()
    local root = getRoot()
    if not root then
        notify("CHARACTER NOT FOUND")
        return
    end

    if shieldVisual then
        shieldVisual:Destroy()
    end

    local sphere = Instance.new("Part")
    sphere.Name = "EggmanShieldVisual"
    sphere.Shape = Enum.PartType.Ball
    sphere.Size = Vector3.new(
        SHIELD_RADIUS * 2,
        SHIELD_RADIUS * 2,
        SHIELD_RADIUS * 2
    )
    sphere.Material = Enum.Material.Glass
    sphere.Color = BLUE
    sphere.Transparency = 0.55
    sphere.Reflectance = 0.15
    sphere.CanCollide = false
    sphere.CanTouch = false
    sphere.CanQuery = false
    sphere.Massless = true
    sphere.Anchored = false
    sphere.CFrame = root.CFrame
    sphere.Parent = workspace

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = sphere
    weld.Parent = sphere

    -- Outline
    local outline = Instance.new("Highlight")
    outline.Name = "EggmanShieldOutline"
    outline.Adornee = sphere
    outline.FillTransparency = 1
    outline.OutlineColor = Color3.fromRGB(80, 210, 255)
    outline.OutlineTransparency = 0
    outline.Parent = sphere

    shieldVisual = sphere
    shieldEnabled = true
    notify("ENERGY SHIELD: ON")
end

local function toggleShield()
    if shieldEnabled then
        shieldEnabled = false

        if shieldVisual then
            shieldVisual:Destroy()
            shieldVisual = nil
        end

        notify("ENERGY SHIELD: OFF")
    else
        createShield()
    end
end

-- JETPACK
local jetpackEnabled = false
local jetpackAttachment = nil

local function toggleJetpack()
    local root = getRoot()
    if not root then
        notify("CHARACTER NOT FOUND")
        return
    end

    jetpackEnabled = not jetpackEnabled

    if jetpackEnabled then
        local attachment = Instance.new("Attachment")
        attachment.Name = "EggmanJetpackFX"
        attachment.Position = Vector3.new(0, -1.5, 0)
        attachment.Parent = root

        local emitter = Instance.new("ParticleEmitter")
        emitter.Texture = "rbxasset://textures/particles/fire_main.dds"
        emitter.Color = ColorSequence.new(
            Color3.fromRGB(255, 60, 20),
            Color3.fromRGB(255, 200, 40)
        )
        emitter.Rate = 90
        emitter.Lifetime = NumberRange.new(0.2, 0.5)
        emitter.Speed = NumberRange.new(4, 8)
        emitter.SpreadAngle = Vector2.new(25, 25)
        emitter.Parent = attachment

        jetpackAttachment = attachment
        notify("JETPACK: ON")
    else
        if jetpackAttachment then
            jetpackAttachment:Destroy()
            jetpackAttachment = nil
        end

        notify("JETPACK: OFF")
    end
end

-- SHIELD HIT: visual wave only
local function shieldHit()
    if not shieldEnabled or not shieldVisual then
        notify("ACTIVATE SHIELD FIRST!")
        return
    end

    local root = getRoot()
    if not root then return end

    local wave = Instance.new("Part")
    wave.Name = "EggmanShieldShockwave"
    wave.Shape = Enum.PartType.Ball
    wave.Material = Enum.Material.Neon
    wave.Color = BLUE
    wave.Transparency = 0.25
    wave.Size = Vector3.new(2, 2, 2)
    wave.Anchored = true
    wave.CanCollide = false
    wave.CanTouch = false
    wave.CanQuery = false
    wave.CFrame = root.CFrame
    wave.Parent = workspace

    local tween = TweenService:Create(
        wave,
        TweenInfo.new(
            0.45,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            Size = Vector3.new(100, 100, 100),
            Transparency = 1
        }
    )

    tween:Play()
    tween.Completed:Connect(function()
        wave:Destroy()
    end)

    notify("SHIELD HIT!")
end

-- LMS SONG
local lmsSound = nil

local function toggleLMS()
    local root = getRoot()
    if not root then
        notify("CHARACTER NOT FOUND")
        return
    end

    if lmsSound then
        lmsSound:Stop()
        lmsSound:Destroy()
        lmsSound = nil
        notify("LMS SONG: OFF")
        return
    end

    local sound = Instance.new("Sound")
    sound.Name = "EggmanLMS"
    sound.SoundId = LMS_ID
    sound.Volume = 0.7
    sound.Looped = true
    sound.Parent = root
    sound:Play()

    lmsSound = sound
    notify("LMS SONG: ON")
end

-- VOICE LINE
local function eggmanVoice()
    local root = getRoot()
    if not root then return end

    local sound = Instance.new("Sound")
    sound.Name = "EggmanVoice"
    sound.SoundId = VOICE_ID
    sound.Volume = 1
    sound.Parent = root
    sound:Play()

    sound.Ended:Connect(function()
        sound:Destroy()
    end)

    notify("EGGMAN VOICE")
end


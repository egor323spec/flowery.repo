local function disconnectCharacterConnections()
    for _, connection in ipairs(characterConnections) do
        connection:Disconnect()
    end
    table.clear(characterConnections)
end

local function playSound(id, parent, volume)
    if not parent or not parent.Parent then return end

    local sound = Instance.new("Sound")
    sound.SoundId = id
    sound.Volume = volume or 1
    sound.Parent = parent
    sound:Play()
    Debris:AddItem(sound, 15)
    return sound
end

local function stopTrack(name)
    local track = tracks[name]
    if track then
        pcall(function()
            track:Stop(0.12)
        end)
    end
end

local function playTrack(name, looped)
    local track = tracks[name]
    if not track then return end

    track.Looped = looped or false
    pcall(function()
        track:Play(0.12)
    end)
end

local function stopMovementTracks()
    stopTrack("Idle")
    stopTrack("Walk")
    stopTrack("Run")
end

local function loadAnimations()
    tracks = {}

    for name, id in pairs(ANIMS) do
        local animation = Instance.new("Animation")
        animation.AnimationId = id

        local ok, track = pcall(function()
            return animator:LoadAnimation(animation)
        end)

        animation:Destroy()

        if ok and track then
            tracks[name] = track
            if name == "Idle" or name == "Walk" or name == "Run" then
                track.Priority = Enum.AnimationPriority.Movement
            else
                track.Priority = Enum.AnimationPriority.Action
            end
        end
    end
end

local function setRunning(value)
    running = value
    if humanoid then
        humanoid.WalkSpeed = running and RUN_SPEED or WALK_SPEED
    end

    if runButton then
        runButton.Text = running and "RUN: ON" or "RUN: OFF"
        runButton.BackgroundColor3 = running
            and Color3.fromRGB(20, 130, 75)
            or Color3.fromRGB(42, 57, 78)
    end
end

local function setupCharacter(char)
    disconnectCharacterConnections()

    character = char
    humanoid = char:WaitForChild("Humanoid")
    root = char:WaitForChild("HumanoidRootPart")

    animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = humanoid
    end

    loadAnimations()

    running = shiftHeld
    humanoid.WalkSpeed = running and RUN_SPEED or WALK_SPEED
    jumpCount = 0
    canDoubleJump = true
    dashActive = false

    table.insert(characterConnections, humanoid.StateChanged:Connect(function(_, state)
        if state == Enum.HumanoidStateType.Landed then
            jumpCount = 0
            canDoubleJump = true
            stopTrack("Fall")
            stopTrack("Jump")
        elseif state == Enum.HumanoidStateType.Freefall then
            if not dashActive then
                stopTrack("Jump")
                playTrack("Fall", true)
            end
        elseif state == Enum.HumanoidStateType.Jumping then
            if jumpCount == 0 then
                jumpCount = 1
                canDoubleJump = true
            end
        end
    end))

    setRunning(running)
    playTrack("Idle", true)
end


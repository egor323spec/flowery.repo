title.Parent = frame

local function makeButton(text, y, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -20, 0, 36)
    button.Position = UDim2.new(0, 10, 0, y)
    button.BackgroundColor3 = Color3.fromRGB(25, 65, 100)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Text = text
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.BorderSizePixel = 0
    button.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 7)
    c.Parent = button

    button.Activated:Connect(callback)
end

makeButton("ENERGY SHIELD [E]", 48, toggleShield)
makeButton("JETPACK BOOST [Q]", 91, toggleJetpack)
makeButton("SHIELD HIT", 134, shieldHit)
makeButton("CRACKED EMPIRE", 177, toggleMusic)
makeButton("CLOSE MENU", 220, function()
    gui:Destroy()
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.E then
        toggleShield()
    elseif input.KeyCode == Enum.KeyCode.Q then
        toggleJetpack()
    end
end)

player.CharacterAdded:Connect(function(char)
    shieldEnabled = false
    jetpackEnabled = false
    shieldToken += 1
    jetpackToken += 1
    shieldPart = nil
    jetpackAttachment = nil

    if musicSound then
        musicSound:Stop()
        musicSound:Destroy()
        musicSound = nil
    end

    task.wait(0.5)
    setupCharacter(char)
end)

frame.Size = UDim2.fromOffset(250, 270)
frame.Position = UDim2.new(0, 20, 0.5, -135)
frame.BackgroundColor3 = Color3.fromRGB(12, 24, 43)
frame.BorderSizePixel = 0
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = frame

local outline = Instance.new("UIStroke")
outline.Color = Color3.fromRGB(0, 170, 255)
outline.Thickness = 2

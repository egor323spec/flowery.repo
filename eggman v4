    button.BackgroundColor3 = Color3.fromRGB(25, 65, 100)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Text = text
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.BorderSizePixel = 0
    button.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 7)
    c.Parent = button

    button.Activated:Connect(callback)
end

makeButton("ENERGY SHIELD [E]", 45, toggleShield)
makeButton("JETPACK BOOST [Q]", 87, toggleJetpack)
makeButton("SHIELD HIT", 129, shieldHit)
makeButton("CRACKED EMPIRE", 171, toggleMusic)
makeButton("MASTER PLAN", 213, playMasterPlan)
makeButton("CLOSE MENU", 255, function()
    gui:Destroy()
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.E then
        toggleShield()
    elseif input.KeyCode == Enum.KeyCode.Q then
        toggleJetpack()
    end
end)

player.CharacterAdded:Connect(function(char)
    shieldToken += 1
    jetpackToken += 1

    shieldEnabled = false
    jetpackEnabled = false
    shieldPart = nil
    jetpackAttachment = nil

    stopSound(musicSound)
    stopSound(masterPlanSound)
    musicSound = nil
    masterPlanSound = nil

    task.wait(0.5)
    setupCharacter(char)
end)

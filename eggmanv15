local function activateShield()
    if shieldActive or not root or not character then
        return
    end

    shieldActive = true
    shieldToken += 1

    local token = shieldToken
    playSound(IDS.Shield, root)

    local ball = Instance.new("Part")
    ball.Name = "EggmanShield"
    ball.Shape = Enum.PartType.Ball
    ball.Size = Vector3.new(0.3, 0.3, 0.3)
    ball.Material = Enum.Material.ForceField
    ball.Color = Color3.fromRGB(115, 200, 255)
    ball.Transparency = 0.4
    ball.CanCollide = false
    ball.CanTouch = false
    ball.CanQuery = false
    ball.Massless = true
    ball.CFrame = root.CFrame
    ball.Parent = character

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = root
    weld.Part1 = ball
    weld.Parent = ball

    shield = ball
    shieldWeld = weld

    TweenService:Create(
        ball,
        TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Size = Vector3.new(11, 11, 11)}
    ):Play()

    task.delay(SHIELD_TIME, function()
        if token ~= shieldToken or not shieldActive then
            return
        end

        shieldActive = false

        if shield and shield.Parent then
            playSound(IDS.Retract, root)

            local oldShield = shield
            local tween = TweenService:Create(
                oldShield,
                TweenInfo.new(0.25),
                {
                    Size = Vector3.new(0.15, 0.15, 0.15),
                    Transparency = 1
                }
            )

            tween:Play()
            tween.Completed:Wait()
        end

        if token == shieldToken then
            destroyShield()
            flashWhite()
            task.wait(0.2)
            flashWhite()
        end
    end)
end


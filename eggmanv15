-- WHITE RINGS MADE FROM NEON SEGMENTS
local function createWhiteRing(position)
    local segmentCount = 40
    local folder = Instance.new("Folder")
    folder.Name = "EggmanRingEffect"
    folder.Parent = workspace

    local segments = {}

    for i = 1, segmentCount do
        local segment = Instance.new("Part")
        segment.Name = "RingSegment"
        segment.Anchored = true
        segment.CanCollide = false
        segment.CanTouch = false
        segment.CanQuery = false
        segment.Material = Enum.Material.Neon
        segment.Color = Color3.new(1, 1, 1)
        segment.Size = Vector3.new(0.15, 0.15, 0.5)
        segment.Parent = folder
        segments[i] = segment
    end

    local started = os.clock()
    local duration = 0.7
    local connection

    connection = RunService.Heartbeat:Connect(function()
        if not folder.Parent then
            connection:Disconnect()
            return
        end

        local alpha = math.clamp((os.clock() - started) / duration, 0, 1)
        local radius = 1 + 9 * alpha
        local center = position + Vector3.new(0, 0.5, 0)

        for i, segment in ipairs(segments) do
            local a1 = ((i - 1) / segmentCount) * math.pi * 2
            local a2 = (i / segmentCount) * math.pi * 2

            local p1 = center + Vector3.new(
                math.cos(a1) * radius,
                math.sin(a1) * radius,
                0
            )

            local p2 = center + Vector3.new(
                math.cos(a2) * radius,
                math.sin(a2) * radius,
                0
            )

            local midpoint = (p1 + p2) / 2
            segment.Size = Vector3.new(
                0.15, 0.15, (p2 - p1).Magnitude + 0.12
            )
            segment.CFrame = CFrame.lookAt(midpoint, p2)
            segment.Transparency = alpha
        end

        if alpha >= 1 then
            connection:Disconnect()
            folder:Destroy()
        end
    end)

    Debris:AddItem(folder, 1.2)
end

local function shieldStrike()
    if not shieldActive or not root then
        return
    end

    playSound(IDS.Strike, root)
    blueShockwave()

    shieldToken += 1
    local token = shieldToken

    task.delay(0.2, function()
        if token ~= shieldToken then
            return
        end

        shieldActive = false
        local position = root.Position
        destroyShield()

        for i = 1, 3 do
            task.delay((i - 1) * 0.2, function()
                createWhiteRing(position)
            end)
        end
    end)
end


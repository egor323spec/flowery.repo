-- EGGMan TEST R6
-- Place LocalScript in StarterPlayer > StarterCharacterScripts

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local character = script.Parent
local humanoid = character:WaitForChild("Humanoid")
local root = character:WaitForChild("HumanoidRootPart")

-- YOUR ANIMATION IDS
local ANIMATIONS = {
    Idle = "rbxassetid://126850823844164",
    Walk = "rbxassetid://90633769714545",
    Run = "rbxassetid://139037627723405",
    Jump = "rbxassetid://75242449879123",
    Fall = "rbxassetid://140113712768097",
    Jetpack = "rbxassetid://76911383572824",
}

local WALK_SPEED = 6
local RUN_SPEED = 25
local JETPACK_SPEED = 70
local JETPACK_DURATION = 3

humanoid.WalkSpeed = WALK_SPEED

-- ANIMATIONS
local animator = humanoid:FindFirstChildOfClass("Animator")
if not animator then
    animator = Instance.new("Animator")
    animator.Parent = humanoid
end

local tracks = {}

for name, id in pairs(ANIMATIONS) do
    local animation = Instance.new("Animation")
    animation.AnimationId = id

    local ok, track = pcall(function()
        return animator:LoadAnimation(animation)
    end)

    if ok and track then
        tracks[name] = track
        track.Priority =
            (name == "Idle" or name == "Walk" or name == "Run")
            and Enum.AnimationPriority.Movement
            or Enum.AnimationPriority.Action
        track.Looped = name ~= "Jump"
    else
        warn("Animation failed:", name, id)
    end
end

local currentTrack

local function playAnimation(name)
    local track = tracks[name]
    if not track or currentTrack == track then
        return
    end

    if currentTrack then
        currentTrack:Stop(0.15)
    end

    currentTrack = track
    track:Play(0.15)
end

local running = false
local jetpacking = false
local jetpackToken = 0

local function updateMovement()
    if jetpacking then return end

    local state = humanoid:GetState()

    if state == Enum.HumanoidStateType.Jumping then
        playAnimation("Jump")
    elseif state == Enum.HumanoidStateType.Freefall then
        playAnimation("Fall")
    elseif humanoid.MoveDirection.Magnitude > 0.05 then
        playAnimation(running and "Run" or "Walk")
    else
        playAnimation("Idle")
    end
end

humanoid.Running:Connect(updateMovement)
humanoid.StateChanged:Connect(updateMovement)


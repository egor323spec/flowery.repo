-- 3D SHIELD
local shield
local shieldEnabled = false
local shieldToken = 0

local function setShield(enabled)
    shieldToken += 1
    local token = shieldToken
    shieldEnabled = enabled

    shieldButton.Text = enabled and "SHIELD: ON" or "SHIELD: OFF"

    if enabled then
        if shield then
            shield:Destroy()
            shield = nil
        end

        local part = Instance.new("Part")
        part.Name = "EggmanTestShield"
        part.Shape = Enum.PartType.Ball
        part.Size = Vector3.new(0.2, 0.2, 0.2)
        part.Material = Enum.Material.ForceField
        part.Color = Color3.fromRGB(70, 180, 255)
        part.Transparency = 0.35
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Massless = true
        part.Anchored = false
        part.CFrame = root.CFrame
        part.Parent = character

        local weld = Instance.new("Weld")
        weld.Part0 = root
        weld.Part1 = part
        weld.C0 = CFrame.new()
        weld.C1 = CFrame.new()
        weld.Parent = part

        shield = part

        for i = 1, 12 do
            if token ~= shieldToken or not shieldEnabled then
                return
            end

            local diameter = 0.2 + (5.5 - 0.2) * i / 12
            part.Size = Vector3.new(diameter, diameter, diameter)
            RunService.Heartbeat:Wait()
        end
    else
        local oldShield = shield
        shield = nil

        if oldShield and oldShield.Parent then
            local startSize = oldShield.Size

            for i = 1, 12 do
                if token ~= shieldToken then return end
                if not oldShield.Parent then return end

                local scale = 1 - i / 12
                oldShield.Size = startSize * scale
                RunService.Heartbeat:Wait()
            end

            if oldShield.Parent then
                oldShield:Destroy()
            end
        end
    end
end

shieldButton.Activated:Connect(function()
    setShield(not shieldEnabled)
end)

-- JETPACK
local function useJetpack()
    if jetpacking then return end

    jetpackToken += 1
    local token = jetpackToken

    jetpacking = true
    humanoid.WalkSpeed = JETPACK_SPEED
    playAnimation("Jetpack")

    local attachment = Instance.new("Attachment")
    attachment.Name = "JetpackFXAttachment"
    attachment.Position = Vector3.new(0, -1.5, 0)
    attachment.Parent = root

    local emitter = Instance.new("ParticleEmitter")
    emitter.Name = "JetpackStars"
    emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    emitter.Color = ColorSequence.new(Color3.new(1, 1, 1))
    emitter.Lifetime = NumberRange.new(0.25, 0.5)
    emitter.Rate = 35
    emitter.Speed = NumberRange.new(2, 5)
    emitter.SpreadAngle = Vector2.new(180, 180)
    emitter.Parent = attachment

    task.delay(JETPACK_DURATION, function()
        if token ~= jetpackToken then return end

        jetpacking = false
        humanoid.WalkSpeed = running and RUN_SPEED or WALK_SPEED

        attachment:Destroy()
        updateMovement()
    end)
end

jetpackButton.Activated:Connect(useJetpack)


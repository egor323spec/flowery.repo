--========================================================
-- CHARACTER HELPERS
--========================================================

local function getCharacter()
    local character = Player.Character
    if not character then
        return nil, nil, nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or humanoid.Health <= 0 then
        return nil, nil, nil
    end

    return character, humanoid, root
end

local function getOrigin()
    local _, _, root = getCharacter()
    if not root then
        return nil
    end

    return root.Position + Vector3.new(0, 2, 0)
end

local function getTarget(origin)
    if not origin then
        return nil
    end

    local target = Mouse.Hit.Position
    local offset = target - origin

    if offset.Magnitude > CONFIG.MaxRange then
        target = origin + offset.Unit * CONFIG.MaxRange
    end

    return target
end

local function ready(key)
    local now = os.clock()
    local previous = lastUse[key] or 0

    if now - previous < (COOLDOWNS[key] or 1) then
        return false
    end

    lastUse[key] = now
    return true
end

